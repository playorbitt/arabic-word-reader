  "pages": [
    {
      "page": 1,
      "printed_page": 3,
      "url": "https://shamela.ws/book/8522/1",
      "paragraphs": [
        {
          "text": "[مقدمة]",
          "heading": true
        },
        {
          "text": "...",
          "heading": false
        },
        {
          "text": "تعريف بالناظم:",
          "heading": false
        },
        {
          "text": "هو جمال الدين محمد بن عبد الله بن عبد الله بن مالك الإمام العلامة الأوحد الطائي الجيّاني الأندلسي، المالكي حين كان بالمغرب الشافعيّ حين انتقل الى المشرق، النحوي نزيل دمشق.",
          "heading": false
        },
        {
          "text": "ولد رحمه الله بجيّان الأندلس سنة ٦٠٠ هـ أو في التي بعدها، وسمع بدمشق من مكرم، وأبي صادق الحسن بن صبّاح، وأبي الحسن السخاوي وغيرهم. وأخذ العربية عن غير واحد فممّن أخذ عنه بجيّان أبو المظفر ثابت بن محمد بن يوسف بن الخيّار الكلاعي من أهل لبلة، وأخذ القراءات عن أبي العبّاس أحمد بن نوار؛ وقرأ كتاب سيبويه على أبي عبد الله بن مالك المرشاني، وجالس ابن يعيش وتلميذه ابن عمرون وغيره بحلب، وتصدّر بها لإقراء العربية، وصرف همته الى إتقان لسان العرب حتى بلغ فيها الغاية، وأربى على المتقدمين. وكان إماما في القراءات وعالما بها، وصنّف فيها قصيدة دالية مرموزة في قدر الشاطبية.",
          "heading": false
        },
        {
          "text": "وأما اللغة فكان إليه المنتهى؛ قال الصفديّ: أخبرني",
          "heading": false
        }
      ]
    },
    {
      "page": 2,
      "printed_page": 4,
      "url": "https://shamela.ws/book/8522/2",
      "paragraphs": [
        {
          "text": "أبو الثناء محمود قال: ذكر ابن مالك يوما ما انفرد به صاحب المحكم عن الأزهريّ في اللغة؛ قال الصفديّ: وهذا أمر يعجز، لأنه يحتاج الى جميع معرفة ما في الكتابين، وأخبرني عنه أنه كان إذا صلى في العادلية ـ لأنه كان إمام المدرسة ـ يشيّعه قاضي القضاة شمس الدين بن خلكان الى بيته تعظيما له. ومع هذا لم ندر لأي سبب أغفل ابن خلكان ترجمته.",
          "heading": false
        },
        {
          "text": "وقد روى عنه الألفية شهاب الدين محمود المذكور، ورواها الصفديّ خليل عن شهاب الدين محمود قراءة، ورواها إجازة عن ناصر الدين شافع بن عبد الظاهر، وعن شهاب الدين بن غانم بالإجازة عنهما عنه. وأما النحو والتصريف فكان فيهما ابن مالك بحرا لا يجارى، وحبرا لا يبارى. وأما اطّلاعه على أشعار العرب التي يستشهد بها على النحو واللغة فكان أمرا عجيبا وكان الأئمة الأعلام يتحيّرون في أمره. وأما الاطلاع على الحديث فكان فيه آية، لأن أكثر ما يستشهد بالقرآن، فإن لم يكن فيه شاهد عدل الى الحديث، وإن لم يكن فيه شاهد عدل الى أشعار العرب؛ هذا مع ما هو عليه من الدين المتين والعبارة وصدق اللهجة وكثرة النوافل وحسن السّمت وكمال العقل.",
          "heading": false
        }
      ]
    },
    {
      "page": 3,
      "printed_page": 5,
      "url": "https://shamela.ws/book/8522/3",
      "paragraphs": [
        {
          "text": "وأقام بدمشق مدة يصنّف ويشتغل بالجامع وبالتربة العادلية، وتخرج عليه جماعة، وكان نظم الشعر عليه سهلا رجزه وطوي…21779 tokens truncated…ُ ... ودونُ والجهاتُ أيضاً وعلُّ",
          "heading": false
        },
        {
          "text": "وأعربوا نصباً إذا ما نكّرا ... قبلا ً وما من بعده قد ذكرا",
          "heading": false
        }
      ]
    },
    {
      "page": 57,
      "printed_page": 38,
      "url": "https://shamela.ws/book/8522/57",
      "paragraphs": [
        {
          "text": "وما يلي المضاف يأتي خلفا ... عنه في الاعراب إذا ما حذفا",
          "heading": false
        },
        {
          "text": "ورّبّما جرّوا الذي أبقوْا كما ... قد كان قبل حذف ما تقدّما",
          "heading": false
        },
        {
          "text": "لكن بشرط أن يكون ما حُذفْ ... مماثلا ً لما عليه قد عُطف",
          "heading": false
        },
        {
          "text": "ويُحذفُ الثاني فيبقى الأوّل ... كحاله إذا به يتصلّ",
          "heading": false
        },
        {
          "text": "بشرط عطفٍ وإضافةٍ إلى ... مثل الذي له أضفت الأوّلا",
          "heading": false
        },
        {
          "text": "فصل مضافٍ شبه فعل ٍ ما نصب ... مفعولا ً أو ظرفا ً أجز ولم يعب",
          "heading": false
        },
        {
          "text": "فصل يمين ٍ واضطرارا وجدا ... بأجنبيٍّ أو بنعتٍ أو ندا",
          "heading": false
        }
      ]
    },
    {
      "page": 58,
      "printed_page": 38,
      "url": "https://shamela.ws/book/8522/58",
      "paragraphs": [
        {
          "text": "[المضاف الى ياء المتكلم]",
          "heading": true
        },
        {
          "text": "...",
          "heading": false
        },
        {
          "text": "لمضاف الى ياء المتكلم:",
          "heading": false
        },
        {
          "text": "آخر ما أضيف لليا اكسر إذا ... لم يك معتلا ًً كرام ٍ وقذا",
          "heading": false
        },
        {
          "text": "أو يكُ كابنين وزيدين فذي ... جميعها اليا بعد فتحها احتذي",
          "heading": false
        },
        {
          "text": "وتدغم اليا فيه والواو وإن ... ما قبل واوٍ ضُمَّ فاكسره يهن",
          "heading": false
        },
        {
          "text": "وألفا ً سلّم وفي المقصور عن ... هذيل ٍ انقلابها ياءً حسن",
          "heading": false
        }
      ]
    },
    {
      "page": 59,
      "printed_page": 38,
      "url": "https://shamela.ws/book/8522/59",
      "paragraphs": [
        {
          "text": "[إعمال المصدر]",
          "heading": true
        },
        {
          "text": "بفعله المصدر ألحق في العمل ... مضافا ً أو مجرّدا ً أو مع أل",
          "heading": false
        },
        {
          "text": "إن كان فعل ّ مع أن أو ما يحلّ ... محلّه ولاسم مصدر ٍ عمل",
          "heading": false
        }
      ]
    },
    {
      "page": 60,
      "printed_page": 39,
      "url": "https://shamela.ws/book/8522/60",
      "paragraphs": [
        {
          "text": "وبعد جرّه الذي أضيف له ... كمّل بنصبٍ أو برفع ٍ عمله",
          "heading": false
        },
        {
          "text": "وجُرَّ ما يتبع ما جرّ ومن ... راعى في الاتباع المحلّ فحسن",
          "heading": false
        }
      ]
    },
    {
      "page": 61,
      "printed_page": 39,
      "url": "https://shamela.ws/book/8522/61",
      "paragraphs": [
        {
          "text": "[إعمال اسم الفاعل]",
          "heading": true
        },
        {
          "text": "كفعله اسم فاعل ٍ في العمل ... إن كان عن مضيّه بمعزل",
          "heading": false
        },
        {
          "text": "وولي استفهاما ً أو حرف ندا ... أو نفيا ً او جاصفة ًً أو مسندا",
          "heading": false
        },
        {
          "text": "وقد يكون نعت محذوف ٍ عُرِف ... فيستحق العمل الذي وصف",
          "heading": false
        },
        {
          "text": "وإن يكن صلة ففي المضي ... وغيره إعماله قد ارتضي",
          "heading": false
        },
        {
          "text": "فعّالّ او مفعالّ او فعول ... في كثرة ٍ عن فاعل ٍ بديل",
          "heading": false
        },
        {
          "text": "فيستحق ماله من عمل ... وفي فعيل ٍ قلّ ذا وفعل",
          "heading": false
        },
        {
          "text": "وما سوى المفرد مثله جعل ... في الحكم والشروط حيثما عمل",
          "heading": false
        },
        {
          "text": "وانصب بذي الإعمال تلوا ً واخفض ... وهو لنصب ما سواه مقتضي",
          "heading": false
        },
        {
          "text": "واجرر أو انصب تابع الذي انخفض ... كمبتغي جاهٍ ومالا ً من نهض",
          "heading": false
        },
        {
          "text": "وكلّ ما قُرّر لاسم فاعل ... يُعطى اسم مفعول ٍ بلا تفاضل",
          "heading": false
        },
        {
          "text": "فهو كفعل ٍ صيغ للمفعول في ... معناه كالمعطى كفافاً يكتفي",
          "heading": false
        },
        {
          "text": "وقد يضاف ذا الى اسم ٍ مرتفع ... معنىً كمحمود المقاصد الورع",
          "heading": false
        }
      ]
    },
    {
      "page": 62,
      "printed_page": 40,
      "url": "https://shamela.ws/book/8522/62",
      "paragraphs": [
        {
          "text": "[أبنية المصادر]",
          "heading": true
        },
        {
          "text": "فعل ّ قياس مصدر المعدّى ... من ذي ثلاثةٍ كردّ ردّا",
          "heading": false
        },
        {
          "text": "وفعل اللازم بابه فعل ... كفرح ٍ وكجوىً وكشلل",
          "heading": false
        },
        {
          "text": "وفعل اللازم مثل قعدا ... له فعولّ باطرّادٍ كغدا",
          "heading": false
        },
        {
          "text": "ما لم يكن مستوجبا ً فعالا ً ... أو فعلاناً فادر أو فعالا",
          "heading": false
        },
        {
          "text": "فأولّ لذي امتناع ٍ كأبى ... والثان للذي اقتضى تقلّبا",
          "heading": false
        },
        {
          "text": "للدّا فعالّ أو لصوت ٍ وشمل ... سيرا ً وصوتا ً الفعيل كصهل",
          "heading": false
        },
        {
          "text": "فعولة ّ فعالة ّ لفعلا ... كسهل الأمرُ وزيدّ جزلا",
          "heading": false
        },
        {
          "text": "وما أتى محالفا لما مضى ... قبابه النقل كسخطٍ ورضا",
          "heading": false
        },
        {
          "text": "وغير ذي ثلاثة ٍ مقيس ... مصدره كقدّس التقديس",
          "heading": false
        },
        {
          "text": "وزكّه تزكية وأجملا ... إجمال من تجمّلا ً تجمّلا",
          "heading": false
        },
        {
          "text": "واستعذ استعاذة ً ثمّ أقم ... إقامة وغالبا ً ذا التا التزم",
          "heading": false
        },
        {
          "text": "ومايلي الآخر مد وافتحا ... مع كسر تلو الثان مما افتتحا",
          "heading": false
        },
        {
          "text": "بهمز وصل ٍ كاصطفى وضمّ ما ... يربع في أمثال قد تلملما",
          "heading": false
        },
        {
          "text": "فعلالّ او فعللة ّ لفعللا ... واجعل مقيسا ً ثانيا ً لا أوّلا",
          "heading": false
        }
      ]
    },
    {
      "page": 63,
      "printed_page": 41,
      "url": "https://shamela.ws/book/8522/63",
      "paragraphs": [
        {
          "text": "لفاعل الفعال والمفاعله ... وغير ما مرّ السّماع عادلة",
          "heading": false
        },
        {
          "text": "وفعلة ّ لمرّة ٍ كجلسه ... وفعلة ّ لهيئة ٍ كجلسه",
          "heading": false
        },
        {
          "text": "في غير ذي الثلاث بالتا المرّه ... وشذّ فيه هيئة ّ كالخمرة",
          "heading": false
        }
      ]
    },
    {
      "page": 64,
      "printed_page": 41,
      "url": "https://shamela.ws/book/8522/64",
      "paragraphs": [
        {
          "text": "[أبنية الفاعلين والمفعولين (والصفات المشبهات بها)]",
          "heading": false
        },
        {
          "text": "...",
          "heading": false
        },
        {
          "text": "أبنية أسماء الفاعلين والمفعولين",
          "heading": false
        },
        {
          "text": "والصفات المشبّهة بها:",
          "heading": false
        },
        {
          "text": "كفاعل ٍ صغ اسم فاعل ٍ إذا ... من ذي ثلاثة ٍ يكون كغذا",
          "heading": false
        },
        {
          "text": "وهو قليل ّ في فعلت وفعل ... غير معدّى بل قياسه فعل",
          "heading": false
        },
        {
          "text": "وأفعل ّ فعلان نحو أشر ... ونحو صديان ونحو الأجهر",
          "heading": false
        },
        {
          "text": "وفعل ّ اولى وفعيل ّ بفعل ... كالضّخم والجميل والفعل جمل",
          "heading": false
        },
        {
          "text": "وأفعل ّ فيه قليل ّ وفعل ... وبسوى الفاعل قد يغنى فعل",
          "heading": false
        },
        {
          "text": "وزنة المضارع اسم فاعل ... من غير ذي الثلاث كالمواصل",
          "heading": false
        },
        {
          "text": "مع كسر متلوّ الأخير مطلقا ... وضمّ ميم زائدٍ قد سبقا",
          "heading": false
        },
        {
          "text": "وإن فتحت منه ما كان انكسر ... صار اسم مفعول ٍ كمثل المنتظر",
          "heading": false
        },
        {
          "text": "وفي اسم مفعول الثلاثيّ اطّرد ... زنة مفعول ٍ كآتٍ من قصد",
          "heading": false
        },
        {
          "text": "وناب نقلا ً عنه ذو فعيل ... نحو فتاة أو فتى كحيل",
          "heading": false
        }
      ]
    },
    {
      "page": 65,
      "printed_page": 42,
      "url": "https://shamela.ws/book/8522/65",
      "paragraphs": [
        {
          "text": "الصّفة المشبّهة باسم الفاعل:",
          "heading": false
        },
        {
          "text": "صفة ّ استحسن جرّ فاعل ... معنىً بها المشبهة اسم الفاعل",
          "heading": false
        },
        {
          "text": "وصوغها من لازم ٍ لحاضر ... كطاهر القلب جميل الظاهر",
          "heading": false
        },
        {
          "text": "وعمل اسم فاعل المعدّى ... لها على الحدّ الذي قد حدّا",
          "heading": false
        },
        {
          "text": "وسبق ما تعمل فيه مجتنب ... وكونه ذا سببيّة ٍ وجب",
          "heading": false
        },
        {
          "text": "فارفع بها وانصب وجرّ مع أل ... ودون أل مصحوب أل وما اتصل",
          "heading": false
        },
        {
          "text": "بها مضافا ً أو مجرّدا ً ولا ... تجرر بها مع أل سما ً من أل خلا",
          "heading": false
        },
        {
          "text": "ومن إضافة ٍ لتاليها وما ... لم يخل فهو بالجواز وسما",
          "heading": false
        }
      ]
    },
    {
      "page": 66,
      "printed_page": 42,
      "url": "https://shamela.ws/book/8522/66",
      "paragraphs": [
        {
          "text": "التعجّب:",
          "heading": false
        },
        {
          "text": "بأفعل انطق بعد ما تعجّبا ... أو جيء بأفعل مجرور ٍ بباء",
          "heading": false
        },
        {
          "text": "وتلو أفعل انصبنّه كما ... أوفى خليلنا وأصدق بهما",
          "heading": false
        },
        {
          "text": "وحذف ما منه تعجّبت استبح ... إن كان عند الحذف معناه يضح",
          "heading": false
        },
        {
          "text": "وفي كلا الفعلين قدما ً لزما ... منع تصرّف ٍ بحكم حتما",
          "heading": false
        },
        {
          "text": "وصغهما من ذي ثلاث ٍ صرّفا ... قابل فضل تمّ غير ذي انتفا",
          "heading": false
        },
        {
          "text": "وغير ذي وصف ٍ يضاهي أشهلا ... وغير سالك ٍ سبيل فعلا",
          "heading": false
        }
      ]
    },
    {
      "page": 67,
      "printed_page": 43,
      "url": "https://shamela.ws/book/8522/67",
      "paragraphs": [
        {
          "text": "وأشدد أو أشدّ أو شبههما ... يخلف ما بعض الشّروط عدما",
          "heading": false
        },
        {
          "text": "ومصدر العادم بعد ينتصب ... وبعد أفعل جرّه بالبا يجب",
          "heading": false
        },
        {
          "text": "وبالنّدور احكم لغير ما ذكر ... ولا تقس على الذي منه أثر",
          "heading": false
        },
        {
          "text": "وفعل هذا الباب لن يقدّما ... معموله ووصله به الزما",
          "heading": false
        },
        {
          "text": "وفضله بظرف ٍ او بحرف جرّ ... مستعمل ّ والخلف في ذاك استقر",
          "heading": false
        }
      ]
    },
    {
      "page": 68,
      "printed_page": 43,
      "url": "https://shamela.ws/book/8522/68",
      "paragraphs": [
        {
          "text": "نِعْمَ وبئس وما جرى مجراهما:",
          "heading": false
        },
        {
          "text": "فعلان غير متصرّفين ... نعم وبئس رافعان اسمين",
          "heading": false
        },
        {
          "text": "مقارني أل أو مضافين لما ... قارنهما كنعم عقبى الكرما",
          "heading": false
        },
        {
          "text": "ويرفعان مضمرا ً يفسّره ... مميّزّ كنعم قوما ً معشره",
          "heading": false
        },
        {
          "text": "وجمع تمييز ٍ وفاعل ٍ ظهر ... فيه خلافّ عنهم قد اشتهر",
          "heading": false
        },
        {
          "text": "وما مميّزّ وقيل فاعل ... في نحو نعم ما يقول الفاضل",
          "heading": false
        },
        {
          "text": "ويذكر المخصوص بعد مبتدا ... أو خبر اسم ليس يبدو أبدا",
          "heading": false
        },
        {
          "text": "وإن يقدّم مشعر به كفى ... كالعلم نعم المقتنى والمقتفى",
          "heading": false
        },
        {
          "text": "واجعل كبئس ساء واجعل فعلا ... من ذي ثلاثةٍ كنعم مسجلا",
          "heading": false
        },
        {
          "text": "ومثل نعم حبّذا الفاعل ذا ... وإن ترد ذمّا ً فقل لا حبّذا",
          "heading": false
        }
      ]
    },
    {
      "page": 69,
      "printed_page": 44,
      "url": "https://shamela.ws/book/8522/69",
      "paragraphs": [
        {
          "text": "وأوّل ذا المخصوص أيا ً كان لا ... تعدل بذا فهو يضاهي المثلا",
          "heading": false
        },
        {
          "text": "وما سوى ذا ارفع بحبّ أو فجرّ ... باليا ودون ذا انضمام الحا كثر",
          "heading": false
        }
      ]
    },
    {
      "page": 70,
      "printed_page": 44,
      "url": "https://shamela.ws/book/8522/70",
      "paragraphs": [
        {
          "text": "أفْعَلّ التفضيل:",
          "heading": false
        },
        {
          "text": "صغ من مصوغ ٍ منه للتعجب ... أفعل للتفضيل وأب اللذ أبي",
          "heading": false
        },
        {
          "text": "وما به إلى تعجّبٍ وصل ... لمانع ٍ به الى التفضيل صل",
          "heading": false
        },
        {
          "text": "وأفعل التفضيل صله أبدا ... تقديرا ً أو لفظا ً بمن إن جرّدا",
          "heading": false
        },
        {
          "text": "وإن لمنكور ٍ يضف أو جرّدا ... ألزم تذكيراً وأن يوحّدا",
          "heading": false
        },
        {
          "text": "وتلوُ أل طبقّ وما لمعرفه ... أضيف ذو وجهين عن ذي معرفه",
          "heading": false
        },
        {
          "text": "هذا إذا نويت معنى من وإن ... لم تنو فهو طبق ما به قرن",
          "heading": false
        },
        {
          "text": "وإن تكن بتلو من مستفهما ... فلهما كن أبداً مقدّما",
          "heading": false
        },
        {
          "text": "كمثل ممّن أنت خيرّ ولدى ... إخبار التقديم نزرا وردا",
          "heading": false
        },
        {
          "text": "ورفعه الظاهر نزرّ ومتى ... عاقب فعلا ً فكثيراً ثبتا",
          "heading": false
        },
        {
          "text": "كلن ترى في النّاس من رفيق ... أولى به الفضل من الصّدّيق",
          "heading": false
        }
      ]
    },
    {
      "page": 71,
      "printed_page": 44,
      "url": "https://shamela.ws/book/8522/71",
      "paragraphs": [
        {
          "text": "النّعت:",
          "heading": false
        },
        {
          "text": "يتبعُ في الإعراب الأسماء الأول ... نعتّ وتوكيدّ وعطفّ وبدل",
          "heading": false
        },
        {
          "text": "فالنّعت تابعّ متمُّ ما سبق ... بوسمه أو وسم ما به اعتلق",
          "heading": false
        }
      ]
    },
    {
      "page": 72,
      "printed_page": 45,
      "url": "https://shamela.ws/book/8522/72",
      "paragraphs": [
        {
          "text": "وليعط في التعريف والتنكير ما ... لما تلا كامرر بقوم ٍ كرما",
          "heading": false
        },
        {
          "text": "وهو لدى التوحيد والتذكير أو ... سواهما كالفعل فاقف ما قفوا",
          "heading": false
        },
        {
          "text": "وانعت بمشتق ٍ كصعبٍ وذرب ... وشبهه كذا وذي والمنتسب",
          "heading": false
        },
        {
          "text": "ونعتوا بجملةٍ منكراً ... فأعطيت ما أعطيته خبراً",
          "heading": false
        },
        {
          "text": "وامنع هنا إيقاع ذات الطلب ... وإن أتت فالقول أضمر تصب",
          "heading": false
        },
        {
          "text": "ونعتوا بمصدر ٍ كثيراً ... فالتزموا الإفراد والتذكيرا",
          "heading": false
        },
        {
          "text": "ونعت غير واحدٍ إذا اختلف ... فعاطفاً فرّقه لا إذا انتلف",
          "heading": false
        },
        {
          "text": "ونعت معمولي وحيدي معنى ... وعمل ٍ أتبع بغير استثنا",
          "heading": false
        },
        {
          "text": "وإن نعوتّ كثرت وقد تلت ... مفتقراً لذكرهنّ أتبعت",
          "heading": false
        },
        {
          "text": "واقطع أو اتبع إن يكن معيّنا ... بدونها أو بعضها اقطع معلنا",
          "heading": false
        },
        {
          "text": "وارفع او انصب إن قطعت مضمرا ... مبتدأ أوناصباً لن يظهرا",
          "heading": false
        },
        {
          "text": "وما من المنعوت والنعت عقل ... يجوز حذفه وفي النعت يقلّ",
          "heading": false
        }
      ]
    },
    {
      "page": 73,
      "printed_page": 45,
      "url": "https://shamela.ws/book/8522/73",
      "paragraphs": [
        {
          "text": "[التوكيد]",
          "heading": true
        },
        {
          "text": "بالنفس أو بالعين الاسم اكدا ... مع ضمير طابق المؤكدا",
          "heading": false
        },
        {
          "text": "واجمعهما بأفعل إن تبعا ... ماليس واحدا تكن متبعا",
          "heading": false
        }
      ]
    },
    {
      "page": 74,
      "printed_page": 46,
      "url": "https://shamela.ws/book/8522/74",
      "paragraphs": [
        {
          "text": "كلا ً اذكر في الشمول وكلا ... كلتا جميعا ً بالضمير موصلا",
          "heading": false
        },
        {
          "text": "واستعملوا أيضا ككلٍّ فاعله ... من عمّ في التوكيد مثل النافلة",
          "heading": false
        },
        {
          "text": "وبعد كلٍّ أكّدوا بأجمعا ... جمعاء أجمعين ثم جمعا",
          "heading": false
        },
        {
          "text": "ودون كلٍّ قد يجىء أجمع ... جمعاء أجمعون ثم جمع",
          "heading": false
        },
        {
          "text": "وإن يفد توكيد منكور ٍ قبل ... وعن نحاة البصرة المنع شمل",
          "heading": false
        },
        {
          "text": "واغن بكلتا في مثنًًّى وكلا ... عن وزن فعلاء ووزن أفعلا",
          "heading": false
        },
        {
          "text": "وإن تؤكد الضمير المتصل ... بالنفس والعين فبعد المنفصل",
          "heading": false
        },
        {
          "text": "عنيت ذا الرّفع وأكّدوا بما ... سواهما والقيد لن يلتزما",
          "heading": false
        },
        {
          "text": "وما من التوكيد لفظيّ يجي ... مكرّرا ً كقولك ادرجي ادرجي",
          "heading": false
        },
        {
          "text": "ولا تعد لفظ ضمير ٍ متّصل ... إلا مع الفظ الذي به وصل",
          "heading": false
        },
        {
          "text": "كذا الحروف غير ما تحصّلا ... به جوابّ كنعم وكبلى",
          "heading": false
        },
        {
          "text": "ومضمر الرّفع الذي قد انفصل ... أكّد به كلَّ ضمير ٍ اتصل",
          "heading": false
        }
      ]
    },
    {
      "page": 75,
      "printed_page": 46,
      "url": "https://shamela.ws/book/8522/75",
      "paragraphs": [
        {
          "text": "[العطف]",
          "heading": true
        },
        {
          "text": "العطف إمّا ذو بيان ٍ أو نسق ... والغرض الآن بيان ما سبق",
          "heading": false
        },
        {
          "text": "فذو البيان تابعّ شبه الصفه ... حقيقة القصد به منكشفه",
          "heading": false
        }
      ]
    },
    {
      "page": 76,
      "printed_page": 47,
      "url": "https://shamela.ws/book/8522/76",
      "paragraphs": [
        {
          "text": "فأولينه من وفاق الأوّل ... ما من وفاق الأوّل النّعت ولي",
          "heading": false
        },
        {
          "text": "فقد يكونان منكّرين ... كما يكونان معرّفين",
          "heading": false
        },
        {
          "text": "وصالحا ً لبدليّة ٍ يرى ... في غير نحو يا غلام ُ يعمرا",
          "heading": false
        },
        {
          "text": "ونحو بشر ٍ تابع البكريّ ... وليس أن يبدل بالمرضي",
          "heading": false
        }
      ]
    },
    {
      "page": 77,
      "printed_page": 47,
      "url": "https://shamela.ws/book/8522/77",
      "paragraphs": [
        {
          "text": "[عطف النسق]",
          "heading": true
        },
        {
          "text": "تالٍ بحرف ٍ متبع ٍ عطف النّسق ... كاخصص بودٍّ وثناءٍ من صدق",
          "heading": false
        },
        {
          "text": "فالعطف مطلقا ً بواو ٍ ثمّ فا ... حتى أم أو كفيك صدقّ ووفا",
          "heading": false
        },
        {
          "text": "وأتبعت لفظاً فحسب بل ولا ... لكن كلم يبد امرؤ لكن طلا",
          "heading": false
        },
        {
          "text": "فاعطف بواو ٍ سابقا ً أو لاحقا ً ... في الحكم أو مصاحبا ً موافقاً",
          "heading": false
        },
        {
          "text": "واخصص بهاعطف الذي لا يغني ... متبوعة كاصطفّ هذا وابني",
          "heading": false
        },
        {
          "text": "والفاء للترتيب باتصال ... وثمّ للترتيب بانفصال",
          "heading": false
        },
        {
          "text": "واخصص بفاءٍ عطف ما ليس صله ... على الذي استقرّ أنه الصّلة",
          "heading": false
        },
        {
          "text": "بعضا بحتّى اعطف على كلٍّ ولا ... يكون إلا غاية الذي تلا",
          "heading": false
        },
        {
          "text": "وأم بها اعطف إثر همز التسوية ... أو همزة ٍ عن لفظ أيٍّ مغنيه",
          "heading": false
        },
        {
          "text": "وربما أسقطت الهمزة إن ... كان خفا المعنى بحذفها أمن",
          "heading": false
        }
      ]
    },
    {
      "page": 78,
      "printed_page": 48,
      "url": "https://shamela.ws/book/8522/78",
      "paragraphs": [
        {
          "text": "وبانقطاع ٍ وبمعنى بل وفت ... إن تك ممّا قيّدت به خلت",
          "heading": false
        },
        {
          "text": "خيّر أبح قسّم وأبهم ... واشكك وإضرابّ بها أيضا ً نمي",
          "heading": false
        },
        {
          "text": "وربّما عاقبت الواو إذا ... لم يلف ذو النطق للبس ٍ منفذا",
          "heading": false
        },
        {
          "text": "ومثل أو القصد إمّا الثانية ... في نحو إمّا ذي وإمّا النّائية",
          "heading": false
        },
        {
          "text": "وأول لكن نفيا ً أو نهيا ً ولا ... نداءً او أمرا ً أو اثباتاً تلا",
          "heading": false
        },
        {
          "text": "وبل كلكن بعد مصحوبيها ... كلم أكن في مربع ٍ بل تيها",
          "heading": false
        },
        {
          "text": "وانقل بها للثان حكم الأوّل ... في الخبر المثبت والأمر الجلي",
          "heading": false
        },
        {
          "text": "وإن على ضمير رفع ٍ متصل ... عطفت فافصل بالضمير المنفصل",
          "heading": false
        },
        {
          "text": "أو فاصل ٍ مّا ولا فصل ٍ يرد ... في النّظم فاشيا ً وضعفه اعتقد",
          "heading": false
        },
        {
          "text": "وعود خافض ٍ لدى عطف ٍ على ... ضمير خفض ٍ لازما ً قد جعلا",
          "heading": false
        },
        {
          "text": "وليس عندي لازما ً إذ قد أتى ... في النّظم والنّثر الصّحيح مثبتا",
          "heading": false
        },
        {
          "text": "والفاء قد تحذف مع ما عطفت ... والواو إذ لا لبس وهي انفردت",
          "heading": false
        },
        {
          "text": "بعطف عامل ٍ مزال ٍ قد بقي ... معموله دفعا ً لوهم ٍ اتقي",
          "heading": false
        },
        {
          "text": "وحذف متبوع ٍ بدا عنا استبح ... وعطفك الفعل على الفعل يصحّ",
          "heading": false
        },
        {
          "text": "واعطف على اسم شبه فعل ٍ فعلا ... وعكسا ً استعمل تجده سهلا",
          "heading": false
        }
      ]
    },
    {
      "page": 79,
      "printed_page": 49,
      "url": "https://shamela.ws/book/8522/79",
      "paragraphs": [
        {
          "text": "[البدل]",
          "heading": true
        },
        {
          "text": "التابع المقصود بالحكم بلا ... واسطة ٍ هو المسمّى بدلا",
          "heading": false
        },
        {
          "text": "مطابقاً أو بعضا ً او ما يشتمل ... عليه يلفى أو كمعطوف ٍ ببل",
          "heading": false
        },
        {
          "text": "وذا للاضراب اعز إن قصدا ًصحب ... ودون قصد ٍ غلط ّ به سلب",
          "heading": false
        },
        {
          "text": "كزره خالدا ً وقبّله اليدا ... واعرفه حقه وخدنبلا ً مُدى",
          "heading": false
        },
        {
          "text": "ومن ضمير الحاضر الظاهر لا ... تبدله إلا ما إحاطة ً جلا",
          "heading": false
        },
        {
          "text": "أو اقتضى بعضا ً او اشتمالا ... كأنّك ابتهاجك استمالا",
          "heading": false
        },
        {
          "text": "وبدل المضمّن الهمز يلي ... همزا ً كمن ذا أسعيدّ أم علي",
          "heading": false
        },
        {
          "text": "ويبدل الفعل من الفعل كمن ... يصل إلينا يستعن بما يعن",
          "heading": false
        }
      ]
    },
    {
      "page": 80,
      "printed_page": 49,
      "url": "https://shamela.ws/book/8522/80",
      "paragraphs": [
        {
          "text": "النّداء:",
          "heading": false
        },
        {
          "text": "وللمنادى النّاء أو كالنّاء يا ... وأي وآكذا أيا ثمّ هيا",
          "heading": false
        },
        {
          "text": "والهمز للدّاني ووا لمن ندب ... أو يا وغير وا لدى اللبس اجتنب",
          "heading": false
        },
        {
          "text": "وغير مندوب ٍ ومضمر ٍ وما ... جامستغاثا ً قد يعرّى فاعلما",
          "heading": false
        },
        {
          "text": "وذاك في اسم الجنس والمشارله ... قلّ ومن يمنعه فانصر عاذله",
          "heading": false
        },
        {
          "text": "وابن المعرّف المنادى المفردا ... عهداعلى الذي في رفعه قد",
          "heading": false
        }
      ]
    },
    {
      "page": 81,
      "printed_page": 50,
      "url": "https://shamela.ws/book/8522/81",
      "paragraphs": [
        {
          "text": "وانو انضمام ما بنوا قبل النّدا ... وليجرى مجرى ذي بناءٍ جدّدا",
          "heading": false
        },
        {
          "text": "والمفرد المنكور والمضافا ... وشبهه انصب عادما ً خلافا",
          "heading": false
        },
        {
          "text": "ونحو زيدٍ ضمّ وافتحنّ من ... نحو أزيد بن سعيدٍ لا تهن",
          "heading": false
        },
        {
          "text": "والضمّ إن لم يل الابن علما ... أو يل الابن علمّ قد حتما",
          "heading": false
        },
        {
          "text": "واضمم أو انصب ما اضطرارا ً نوّنا ... مّما له استحقاق ضمٍّ بيّنا",
          "heading": false
        },
        {
          "text": "وباضطرار ٍ خصّ جمع يا وأل ... إلا مع الله ومحكيّ الجُمل",
          "heading": false
        },
        {
          "text": "والأكثر اللهمّ بالتعويض ... وشذّ يا اللهمّ في قريض",
          "heading": false
        }
      ]
    },
    {
      "page": 82,
      "printed_page": 50,
      "url": "https://shamela.ws/book/8522/82",
      "paragraphs": [
        {
          "text": "فصل: ّّ",
          "heading": false
        },
        {
          "text": "تابع ذي الضمِِّ المضاف دون أل ... ألزمه نصبا ً كأزيد ذا الحيل",
          "heading": false
        },
        {
          "text": "وما سواه ارفع أو انصب واجعلا ... كمستقلٍّ نسقا ً وبدلا",
          "heading": false
        },
        {
          "text": "وإن يكن مصحوب أل ما نسقا ... ففيه وجهان ورفع ينتقى",
          "heading": false
        },
        {
          "text": "وأيها مصحوب ال بعد صفه ... يلزم بالرّفع لدى ذي المعرفة",
          "heading": false
        },
        {
          "text": "رأيُّ هذا أيها الذي ورد ... ووصف أي بسوى هذا يُردّ",
          "heading": false
        },
        {
          "text": "وذو إشارة ٍ كأيٍّ في الصفه ... إن كان تركها يفيت المعرفه",
          "heading": false
        },
        {
          "text": "في نحو سعد سعد الأوس ينتصب ... ثان ٍ وضمَّ وافتح اوّلا تصب",
          "heading": false
        }
      ]
    },
    {
      "page": 83,
      "printed_page": 51,
      "url": "https://shamela.ws/book/8522/83",
      "paragraphs": [
        {
          "text": "المنادى المضاف الى ياء المتكلّم:",
          "heading": false
        },
        {
          "text": "واجعل منادىً صحّ إن يُضف ليا",
          "heading": false
        },
        {
          "text": "... كعبدِ عبدي عبد عبدا عبديا",
          "heading": false
        },
        {
          "text": "وفتحّ او كسرّ وحذف اليا استمر",
          "heading": false
        },
        {
          "text": "... في يا ابن أمِّ يا ابن عمّ لا مفر",
          "heading": false
        },
        {
          "text": "وفي النّدا \" أبتِ\" \" أمّتِ\" عرض",
          "heading": false
        },
        {
          "text": "... واكسر أوافتح ومن اليا التا عوض",
          "heading": false
        }
      ]
    },
    {
      "page": 84,
      "printed_page": 51,
      "url": "https://shamela.ws/book/8522/84",
      "paragraphs": [
        {
          "text": "[أسماء لازمت النداء]",
          "heading": true
        },
        {
          "text": "\"وفل\" بعض ما يخصّ بالندا ... لؤمان نومان كذا واطّردا",
          "heading": false
        },
        {
          "text": "في سبّ الانثى وزن يا خباث ... والأمر هكذا من الثلاثي",
          "heading": false
        },
        {
          "text": "وشاع في سبّ الذكور فعل",
          "heading": false
        },
        {
          "text": "... ولا تقس وجرّ في الشعر فل",
          "heading": false
        }
      ]
    },
    {
      "page": 85,
      "printed_page": 51,
      "url": "https://shamela.ws/book/8522/85",
      "paragraphs": [
        {
          "text": "[الاستغاثة]",
          "heading": true
        },
        {
          "text": "إذا استغيث اسمّ منادىً خُفضا ... باللام مفتوحاً كيا للمرتضى",
          "heading": false
        },
        {
          "text": "وافتح مع المعطوف إن كرّرت يا ... وفي سوى ذلك بالكسر ائتيا",
          "heading": false
        },
        {
          "text": "ولامُ ما استغيث عاقبت ألِف ... ومثله اسمّ ذو تعجّبٍ ألِف",
          "heading": false
        }
      ]
    },
    {
      "page": 86,
      "printed_page": 51,
      "url": "https://shamela.ws/book/8522/86",
      "paragraphs": [
        {
          "text": "النّدبة:",
          "heading": false
        },
        {
          "text": "ما للمنادى اجعل لمندوبٍ وما ... نُكّر لم يندب ولا ما أبهما",
          "heading": false
        },
        {
          "text": "ويندب الموصول بالذي اشتهر ... كبئر زمزم ٍ يلي وا من حفر",
          "heading": false
        }
      ]
    },
    {
      "page": 87,
      "printed_page": 52,
      "url": "https://shamela.ws/book/8522/87",
      "paragraphs": [
        {
          "text": "ومنتهى المندوب صله بالألف ... متلوّها إن كان مثلها حُذف",
          "heading": false
        },
        {
          "text": "كذاك تنوين الذي به كمل ... من صلةٍ أو غيرها نلت الأمل",
          "heading": false
        },
        {
          "text": "والشكل حتماً أوله مجانساً ... إن يكن الفتح بِِِِوَهم ٍ لابسا",
          "heading": false
        },
        {
          "text": "وواقفاً زد هاء سكت ٍ إن تُرِد ... وإن تشأ فالمدّ والها لا تزد",
          "heading": false
        },
        {
          "text": "وقائلّ واعبديا واعبدا ... من في النّدا اليا ذا سكون ٍ أبدى",
          "heading": false
        }
      ]
    },
    {
      "page": 88,
      "printed_page": 52,
      "url": "https://shamela.ws/book/8522/88",
      "paragraphs": [
        {
          "text": "[الترخيم]",
          "heading": true
        },
        {
          "text": "ترخيماً احذف اخِرَ المنادى ... كيا سعا فيمن دعا سعادا",
          "heading": false
        },
        {
          "text": "وجوّزنه مطلقا في كلّ ما ... أنث بالها وبالذي قد رُخِّما",
          "heading": false
        },
        {
          "text": "بحذفها وفّره بعد واحظلا ... ترخيم ما من هذه الها قد خلا",
          "heading": false
        },
        {
          "text": "إلا الرباعيّ فما فوق العلم ... دون إضافةٍ وإسنادٍ متمّ",
          "heading": false
        },
        {
          "text": "ومع الآخر احذف الذي تلا ... إن ريد ليْناً ساكناً مكمّلا",
          "heading": false
        },
        {
          "text": "أربعة ً فصاعداً والخُلفُ في ... واو ٍ وياءٍ بهما فتحّ قفي",
          "heading": false
        },
        {
          "text": "والعجز احذف من مركّبٍ وقل ... ترخيم حُملةٍ وذا عمروّ نقل",
          "heading": false
        },
        {
          "text": "وإن نويت بعد حذف ما حُذف ... فالباقي استعمل بما فيه أُلِف",
          "heading": false
        },
        {
          "text": "واجعله إن لم تنو محذوفاً كما ... لو كان بالآخر وضعاً تُمِّما",
          "heading": false
        }
      ]
    },
    {
      "page": 89,
      "printed_page": 53,
      "url": "https://shamela.ws/book/8522/89",
      "paragraphs": [
        {
          "text": "فقل على الأول في ثمود يا ... ثمو ويا ثمي على الثاني بيا",
          "heading": false
        },
        {
          "text": "والتزم الأوّل في كمُسمله ... وجوّز الوجهين في كمَسلمه",
          "heading": false
        },
        {
          "text": "ولاضطرار ٍ رخّموا دون ندا ... ما للنّدا يصلح نحو أحمد",
          "heading": false
        }
      ]
    },
    {
      "page": 90,
      "printed_page": 53,
      "url": "https://shamela.ws/book/8522/90",
      "paragraphs": [
        {
          "text": "لاختصاص:",
          "heading": false
        },
        {
          "text": "الاختصاصّ كنداءٍ دون يا",
          "heading": false
        },
        {
          "text": "... كأيها الفتى بإثر ارجونيا",
          "heading": false
        },
        {
          "text": "وقد يُرى ذا دون أيٍّ تلو أل",
          "heading": false
        },
        {
          "text": "... كمثل نحن العُرْبَ أسخى مَن بذل",
          "heading": false
        }
      ]
    },
    {
      "page": 91,
      "printed_page": 53,
      "url": "https://shamela.ws/book/8522/91",
      "paragraphs": [
        {
          "text": "التحذير والأغراء:",
          "heading": false
        },
        {
          "text": "إيّاك والشّرّ ونحوه نصب ... محذّرّّ بما استتاره وجب",
          "heading": false
        },
        {
          "text": "ودون عطف ٍ ذا لأيّا انسب وما ... سواه ستر فعله لن يلزما",
          "heading": false
        },
        {
          "text": "إلا مع العطف أو التكرار ... كالضّيغم الضيم يا ذا السّاري",
          "heading": false
        },
        {
          "text": "وشذّ إيّاي وإيّاه أشذّ ... وعن سبيل القصد من قاس انتبذ",
          "heading": false
        },
        {
          "text": "وكمُحدّر ٍ بلا إيّا اجعلا ... مغزىً به كُلِّ ما قد فُصِّلا",
          "heading": false
        }
      ]
    },
    {
      "page": 92,
      "printed_page": 53,
      "url": "https://shamela.ws/book/8522/92",
      "paragraphs": [
        {
          "text": "[أسماء الأفعال والأصوات]",
          "heading": true
        },
        {
          "text": "ما ناب عن فعل ٍ كشتّان وصه ... هو اسم فعل ٍٍ وكذا أوّه ومَه",
          "heading": false
        },
        {
          "text": "وما بمعنى افعل كآمين كثر ... وغيرُهُ كوي وهيهات نزر",
          "heading": false
        }
      ]
    },
    {
      "page": 93,
      "printed_page": 54,
      "url": "https://shamela.ws/book/8522/93",
      "paragraphs": [
        {
          "text": "والفعل من أسمائه عليكما ... وهكذا دونك مع إليكما",
          "heading": false
        },
        {
          "text": "كذا رويد بله ناصبين ... ويعملان الخفض مصدرين",
          "heading": false
        },
        {
          "text": "وما لما تنوب عنه عن عمل ... لها وأخّر مالذي فيه العمل",
          "heading": false
        },
        {
          "text": "واحكم بتنكير الذي ينوّن ... منها وتعربف سواه بيّن",
          "heading": false
        },
        {
          "text": "وما به خوطب ما لا يعقل ... من مُشبِهِ اسم الفعل صوتا يجعل",
          "heading": false
        },
        {
          "text": "كذا الذي أجدى حكاية ً كقب ... والزم بنا النّوعين فهو قد وجب",
          "heading": false
        }
      ]
    },
    {
      "page": 94,
      "printed_page": 54,
      "url": "https://shamela.ws/book/8522/94",
      "paragraphs": [
        {
          "text": "[نونا التوكيد]",
          "heading": true
        },
        {
          "text": "للفعل توكيدّ بنونين هما ... كنوني اذهبنّ واقصدنهما",
          "heading": false
        },
        {
          "text": "يؤكّدان افعل ويفعل آتيا ... ذا طلبٍ أو شرطاً أمّا تاليا",
          "heading": false
        },
        {
          "text": "أو مثبتاً في قسم ٍ مستقبلا ... وقلّ بعد ما ولم وبعد لا",
          "heading": false
        },
        {
          "text": "وغير إمّا من طوالب الجزا ... وآخر المؤكّد افتح كابرزا",
          "heading": false
        },
        {
          "text": "واشكله قبل مضمر ٍ لين ٍ بما ... جانس من تحرّك قد علما",
          "heading": false
        },
        {
          "text": "والمضمر احذفنّه إلا الألف ... وإن يكن في آخر الفعل ألف",
          "heading": false
        },
        {
          "text": "فاجعله منه رافعا غير اليا ... والواو ياءً كاسعينَّ سعيا",
          "heading": false
        },
        {
          "text": "واحذفه من رافع هاتين ٍ وفي ... وا ويا شكل ّ مجانسّ قفي",
          "heading": false
        }
      ]
    },
    {
      "page": 95,
      "printed_page": 55,
      "url": "https://shamela.ws/book/8522/95",
      "paragraphs": [
        {
          "text": "نحو اخشين يا هند بالكسر ويا ... قوم اخشون واضمم وقس مسويّا",
          "heading": false
        },
        {
          "text": "ولم تقع خفيفة ّ بعد الألف ... لكن شديدة ّ وكسرها ألف",
          "heading": false
        },
        {
          "text": "وألِفاً زد قبلها مؤكّداً ... فعلا ً الى نون الإناث أسندا",
          "heading": false
        },
        {
          "text": "واحذف خفيفة ً لساكن ٍ ردف ... وبعد غير فتحة ٍ إذا تقف",
          "heading": false
        },
        {
          "text": "واردد إذا حذفتها في الوقف ما ... من أجلها في الوصل كان عُدِما",
          "heading": false
        },
        {
          "text": "وأبدلنها بعد فتح ٍ ألِفا ... وقفاً كما تقول في قفنْ قفا",
          "heading": false
        }
      ]
    },
    {
      "page": 96,
      "printed_page": 55,
      "url": "https://shamela.ws/book/8522/96",
      "paragraphs": [
        {
          "text": "[ما لا ينصرف]",
          "heading": true
        },
        {
          "text": "الصّرف تنوينّ أتى مبيّنا ... معنىً به يكون الاسم أمكنا",
          "heading": false
        },
        {
          "text": "فألف التأنيث مطلقاً منع ... صرف الذي حواه كيفما وقع",
          "heading": false
        },
        {
          "text": "وزائدا فعلان في وصف سلم ... من أن يُرى بتاء تأنيث ٍ خُتِم",
          "heading": false
        },
        {
          "text": "ووصفّ أصليٌ ووزن أفعلا ... ممنوع تأنيث ٍ بتا كأشهلا",
          "heading": false
        },
        {
          "text": "وألغينّ عارض الوصفيّه ... كأربع ٍ وعارض الإسميه",
          "heading": false
        },
        {
          "text": "فالأدهم القيد لكونه وُضِع ... في الأصل وصفاً انصرافه مُنِع",
          "heading": false
        },
        {
          "text": "وأجدل ّ وأخيل ّ وأنعى ... مصروفة ّ وقد ينلن المنعا",
          "heading": false
        },
        {
          "text": "ومنع عدل ٍ مع وصف ٍ معتبر ... في لفظ مثنى وثلاث وأخر",
          "heading": false
        }
      ]
    },
    {
      "page": 97,
      "printed_page": 56,
      "url": "https://shamela.ws/book/8522/97",
      "paragraphs": [
        {
          "text": "ووزن مثنى وثلاث كهما ... من واحدٍ لأربع ٍ فليعلما",
          "heading": false
        },
        {
          "text": "وكن لجمع ٍ مشبهٍ مفاعلا ... أو المفاعيل بمنع ٍ كافلا",
          "heading": false
        },
        {
          "text": "وذا اعتلال ٍ منه كالحواري ... رفعاً وجرًّا أجرِه كساري",
          "heading": false
        },
        {
          "text": "ولسراويل بهذا الجمع ... شبه ّ اقتضى عموم المنع",
          "heading": false
        },
        {
          "text": "وإن به سُمِّي أو بما لحق ... به فالانصراف منعه يحقّ",
          "heading": false
        },
        {
          "text": "والعلم امنع صرفه مركّبا ... تركيب مزج ٍ نحو معديكربا",
          "heading": false
        },
        {
          "text": "كذاك حاوي زائدي فعلانا ... كغطفان وكأصبهانا",
          "heading": false
        },
        {
          "text": "كذا مؤنّثّ بهاءٍ مطلقا ... وشرط منع العار كونه ارتقى",
          "heading": false
        },
        {
          "text": "فوق الثلاث أو كجور أو سقر ... أو زيدٍ اسم امرأة ٍ لا اسم ذكر",
          "heading": false
        },
        {
          "text": "وجهان في العادم تذكيراً سبق ... وعُجمة ً كهند والمنعُ أحق",
          "heading": false
        },
        {
          "text": "والعجميّ الوضع والتعريف مع ... زيدٍ على الثلاث صرفُه ُ امتنع",
          "heading": false
        },
        {
          "text": "كذاك ذو وزن ٍ يخصّ الفعلا ... أو غالبٍ كأحمدٍ ويعلى",
          "heading": false
        },
        {
          "text": "وما يصير علَماً من ذي ألِف ... زيدت لإلحاق ٍ فليس ينصرف",
          "heading": false
        },
        {
          "text": "والعلم امنع صرفه إن عدلا ... كفعل التوكيد أو كثعلا",
          "heading": false
        },
        {
          "text": "والعدل والتعريف مانعاً سحر ... إذا به التعيين قصداً يُعتبر",
          "heading": false
        },
        {
          "text": "ابن على الكسر فعال علما ... مؤنّثاً وهو نظير جشما",
          "heading": false
        }
      ]
    },
    {
      "page": 98,
      "printed_page": 57,
      "url": "https://shamela.ws/book/8522/98",
      "paragraphs": [
        {
          "text": "عند تميم واصرفن ما نكّرا ... من كلّ ما التعريف فيه أثّرا",
          "heading": false
        },
        {
          "text": "وما يكون منه منقوصاً ففي ... إعرابه نهج جوار ٍ يقتفي",
          "heading": false
        },
        {
          "text": "ولاضطرار ٍ أو تناسبٍ صُرِف ... ذو المنع والمصروفُ قد لا ينصرف",
          "heading": false
        }
      ]
    },
    {
      "page": 99,
      "printed_page": 57,
      "url": "https://shamela.ws/book/8522/99",
      "paragraphs": [
        {
          "text": "[إعراب الفعل]",
          "heading": true
        },
        {
          "text": "رفع مضارعاً إذا يُجرّد ... من ناصبٍ وجازم ٍ كتسعد",
          "heading": false
        },
        {
          "text": "وبلن انصبه وكي كذا بأن ... لا بعد علم ٍ والتي من بعد ظنّ",
          "heading": false
        },
        {
          "text": "فانصب بها والرّفع صحّح واعتقد ... تخفيفها من أنّ فهو مطّرد",
          "heading": false
        },
        {
          "text": "وبعضهم أهمل أن حملا ً على ... ما أختها حيث استحقّت عملا",
          "heading": false
        },
        {
          "text": "ونصبوا بإذن المستقبلا ... إن صدّرت والفعل بعد موصلا",
          "heading": false
        },
        {
          "text": "أو قبله اليمين وانصب وارفعا ... إذا إذن من بعد عطف ٍٍوقعا",
          "heading": false
        },
        {
          "text": "وبين لا ولام جرٍّ إلتزم ... إظهار أن ناصبة ً وإن عُدِم",
          "heading": false
        },
        {
          "text": "لا فأن اعمل مظهراً أو مضمراً ... وبعد نفي كان حتماً أضمرا",
          "heading": false
        },
        {
          "text": "كذاك بعد أو إذا يصلح في ... موضعها حتى أو والا أن خفي",
          "heading": false
        },
        {
          "text": "وبعد حتى هكذا إضمار أن ... حتمّ كجد حتى تُسَرّد ذا حزن",
          "heading": false
        },
        {
          "text": "وتلو حتّى حالا ً أو مؤولا ً ... به ارفعنّ وانصب المستقبلا",
          "heading": false
        }
      ]
    },
    {
      "page": 100,
      "printed_page": 58,
      "url": "https://shamela.ws/book/8522/100",
      "paragraphs": [
        {
          "text": "وبعد فا جواب نفي ٍ أو طلب ... محضين أن وسترها حتمّ نصب",
          "heading": false
        },
        {
          "text": "والواو كالفا إن تفد مفهوم مع ... كلا تكن جلداً وتظهر الجزع",
          "heading": false
        },
        {
          "text": "وبعد غير النفي جزماً اعتمد ... إن تسقط الفا والجزاء قد قُصِد",
          "heading": false
        },
        {
          "text": "وشرط جزم ٍ بعد نهي أن تضع ... إن قبل لا دون تخالف ٍ يقع",
          "heading": false
        },
        {
          "text": "والأمر إن كان بغير افعل فلا ... تنصب جوابه وجزمه اقبلا",
          "heading": false
        },
        {
          "text": "والفعل بعد الفاء في الرّجا نُصِب ... كنصب ما الى التمنّى ينتسب",
          "heading": false
        },
        {
          "text": "وإن على اسم ٍ خالص ٍ فعل ّ عُطِف ... تنصبه أن ثابتاً أو منحذف",
          "heading": false
        },
        {
          "text": "وشذّ حذف أن ونصبّ في سوى ... ما مرّ فاقبل منه عدل ّ روى",
          "heading": false
        }
      ]
    },
    {
      "page": 101,
      "printed_page": 58,
      "url": "https://shamela.ws/book/8522/101",
      "paragraphs": [
        {
          "text": "[عوامل الجزم]",
          "heading": true
        },
        {
          "text": "بلا ولام ٍ طالباً ضع جزما ... في الفعل هكذا بلم ولمّا",
          "heading": false
        },
        {
          "text": "واجزم بإن ومن وما ومهما ... أيٍّ متى أيّان أين إذ ما",
          "heading": false
        },
        {
          "text": "وحيثما أتى وحرفّ إذ ما ... كإن وباقي الأدوات أسما",
          "heading": false
        },
        {
          "text": "فعلين يقتضين شرط ّ قدِّما ... يتلو الجزاء وجواباً وُسِما",
          "heading": false
        },
        {
          "text": "وماضيين أو مضارعين ... تلفيهما أو متخالفين",
          "heading": false
        },
        {
          "text": "وبعد ماض ٍ رفعك الجزا حسن ... ورفعه بعد مضارع ٍ وهن",
          "heading": false
        },
        {
          "text": "واقرن بفا حتماً جواباً لو جُعِل ... شرطاً لإن أو غيرها لم ينجعل",
          "heading": false
        }
      ]
    },
    {
      "page": 102,
      "printed_page": 59,
      "url": "https://shamela.ws/book/8522/102",
      "paragraphs": [
        {
          "text": "وتخلف الفاء إذا المفاجأة ... كإن تجد إذا لنا مكافأة",
          "heading": false
        },
        {
          "text": "والفعل ُ من بعد الجزا إن يقترن ... بالفا أو الواو بتثليثٍ قمِن",
          "heading": false
        },
        {
          "text": "وجزمّ او نصبّ لفعل ٍ إثر فا ... أو واوٍ ان بالجملتين اكتُنِفا",
          "heading": false
        },
        {
          "text": "والشرط يُغني عن جوابٍ قد عُلِم ... والعكس قد يأتي إن المعنى فُهِِِِم",
          "heading": false
        },
        {
          "text": "واحذف لدى اجتماع شرط ٍ وقسم ... جواب ما أخّرت فهو ملتزم",
          "heading": false
        },
        {
          "text": "وإن تواليا وقبل ذو خبر ... فالشّرط رجّح مطلقاً بلا حذر",
          "heading": false
        },
        {
          "text": "وربّما رُجِّح بعد قسم ... شرط ّ بلا ذي خبر ٍ مقدّم",
          "heading": false
        }
      ]
    },
    {
      "page": 103,
      "printed_page": 59,
      "url": "https://shamela.ws/book/8522/103",
      "paragraphs": [
        {
          "text": "[فصل لو]",
          "heading": true
        },
        {
          "text": "لو حرف شرط ٍ في مضيٍّ ويقلّ ... إيلاؤه مستقبلا ً لكن قبِِل",
          "heading": false
        },
        {
          "text": "وهي في الاختصاص بالفعل كإن ... لكنّ لو أنّ بها قد تقترن",
          "heading": false
        },
        {
          "text": "وإن مضارع ّ تلاها صُرِفا ... الى المضيِّ نحو لو يفي كفى",
          "heading": false
        }
      ]
    },
    {
      "page": 104,
      "printed_page": 59,
      "url": "https://shamela.ws/book/8522/104",
      "paragraphs": [
        {
          "text": "أمّا ولولا ولوما:",
          "heading": false
        },
        {
          "text": "أمّا كمهما يك من شيءٍ وفا ... لتلو تلوها وجوباً ألفا",
          "heading": false
        },
        {
          "text": "وحذف ذي الفا قلَّ في نثر ٍ إذا ... لم يك قول ّ معها قد نُبِذا",
          "heading": false
        },
        {
          "text": "لولا ولوما يلزمان الابتدا ... إذا امتناعاً بوجودٍ عقدا",
          "heading": false
        }
      ]
    },
    {
      "page": 105,
      "printed_page": 60,
      "url": "https://shamela.ws/book/8522/105",
      "paragraphs": [
        {
          "text": "وبهما التحضيض مز وهلا ... ألاّ ألا وأولينها الفعلا",
          "heading": false
        },
        {
          "text": "وقد يليها اسم ّ بفعل ٍ مُضمَر ٍ ... علّق أو بظاهر ٍ مؤخّر",
          "heading": false
        }
      ]
    },
    {
      "page": 106,
      "printed_page": 61,
      "url": "https://shamela.ws/book/8522/106",
      "paragraphs": [
        {
          "text": "الإخبار بالذي والألف واللام:",
          "heading": false
        },
        {
          "text": "ما قيل أخبر عنه بالذي خبر ... عن الذي مبتدأ قبل استقر",
          "heading": false
        },
        {
          "text": "وما سواهما فوسّطه صله ... عائدها خلف معطي التكملة",
          "heading": false
        },
        {
          "text": "نحو الذي ضربته زيدّ فذا ... ضربت زيداً كان فادر المأخذا",
          "heading": false
        },
        {
          "text": "وباللذين واللذين والتي ... أخبر مراعياً وفاق المثبت",
          "heading": false
        },
        {
          "text": "قبول تأخير ٍ وتعريف ٍ لما ... أخبر عنه هاهنا قد حتما",
          "heading": false
        },
        {
          "text": "كذا الغِني عنه بأجنبيٍّ أو ... بمُضمَر ٍ شرط ّ فراع ما رعوا",
          "heading": false
        },
        {
          "text": "وأخبروا هنا بأل عن بعض ما ... يكون فيه الفعل قد تقدّما",
          "heading": false
        },
        {
          "text": "إن صحّ صوغ صلة ٍ منه لأل ... كصوغ واق ٍ من وقى الله البطل",
          "heading": false
        },
        {
          "text": "وإن يكن ما رفعت صلة أل ... نمير غيرها أبين وانفصل",
          "heading": false
        }
      ]
    },
    {
      "page": 107,
      "printed_page": 61,
      "url": "https://shamela.ws/book/8522/107",
      "paragraphs": [
        {
          "text": "ومائة ٍ والألف للفرد أضِف ... ومائة ّ بالجمع نزراً قد رُدف",
          "heading": false
        },
        {
          "text": "وأحد ذكر وصلنه بعشر ... مركّباً قاصِد معدود ٍ ذكر",
          "heading": false
        },
        {
          "text": "وقل لدى التأنيث إحدى عشره ... والشين فيها عن تميم ٍ كسره",
          "heading": false
        },
        {
          "text": "ومع غير أحدٍ وإحدى ... ما معهما فعلت فافعل قصدا",
          "heading": false
        },
        {
          "text": "ولثلاثة ٍ وتسعة ٍ وما ... بينهما إن رُكِّبا ما قدّما",
          "heading": false
        },
        {
          "text": "وأول عشرة اثنتي وعشرا ... إثني إذا أثنى تشا أو ذكرا",
          "heading": false
        },
        {
          "text": "واليا لغير الرّفع وارفع بالألف ... والفتح في جزأي سواهما ألف",
          "heading": false
        },
        {
          "text": "وميّز العشرين للتسعينا ... بواحدٍ كأربعين حينا",
          "heading": false
        },
        {
          "text": "وميّزوا مركّباً بمثل ما ... مُيِّز عشرون فسوّينهما",
          "heading": false
        },
        {
          "text": "وإن أضيف عدد ّ مركّبّ ... يبق البنا وعجز ّ قد يُعرَبُ",
          "heading": false
        },
        {
          "text": "وصغ من اثنين فما فوق إلى ... عشرة ٍ كفاعل ٍ من فعلا",
          "heading": false
        },
        {
          "text": "واختمه في التأنيث بالتا ومتى ... ذكّرت فاذكر فاعلا ً بغير تا",
          "heading": false
        },
        {
          "text": "وإن تُرِد بعض الذي منه بُنِي ... تضف إليه مثل بعض ٍ بيّن",
          "heading": false
        },
        {
          "text": "وإن ترد جعل الأقل مثل ما ... فوق فحكم جاعل له احكما",
          "heading": false
        },
        {
          "text": "وإن أردت مثل ثاني اثنين ... مركّباً فجئ بتركيبين",
          "heading": false
        }
      ]
    },
    {
      "page": 108,
      "printed_page": 62,
      "url": "https://shamela.ws/book/8522/108",
      "paragraphs": [
        {
          "text": "أو فاعلا ً بحالتيه أضف ... الى مركّبٍ بما تنوي يفي",
          "heading": false
        },
        {
          "text": "وشاع الاستعنا بحادي عشرا ... ونحوه وقبل عشرين اذكرا",
          "heading": false
        },
        {
          "text": "وبابه الفاعل من لفظ العدد ... بحالتيه قبل واو ٍ يُعتمد",
          "heading": false
        }
      ]
    },
    {
      "page": 109,
      "printed_page": 60,
      "url": "https://shamela.ws/book/8522/109",
      "paragraphs": [
        {
          "text": "[العدد]",
          "heading": true
        },
        {
          "text": "ثلاثة ً بالتاء قل للعشره ... في عدِّ ما احادُهُ مذكّره",
          "heading": false
        },
        {
          "text": "في الضِّدِّ جرِّد والمميز اجرر ... جمعاً بلفظ قلة ٍ في الأكثر",
          "heading": false
        }
      ]
    },
    {
      "page": 110,
      "printed_page": 62,
      "url": "https://shamela.ws/book/8522/110",
      "paragraphs": [
        {
          "text": "[كم وكأي وكذا]",
          "heading": true
        },
        {
          "text": "...",
          "heading": false
        },
        {
          "text": "كم وكأيِّن وكذا:",
          "heading": false
        },
        {
          "text": "ميِّز في الاستفهام كم بمثل ما ... ميَّزت عشرين ككم شخصا سما",
          "heading": false
        },
        {
          "text": "وأجز أن تجرّه من مضمرا ... إن وليت كم حرف جرٍّ مظهرا",
          "heading": false
        },
        {
          "text": "واستعملنها مخبراً كعشره ... أو مائة ٍ ككم رجال ٍ أو مره",
          "heading": false
        },
        {
          "text": "ككم كأيِّن وكذا وينتصب ... تمييز ذين أو به صل من تصب",
          "heading": false
        }
      ]
    },
    {
      "page": 111,
      "printed_page": 62,
      "url": "https://shamela.ws/book/8522/111",
      "paragraphs": [
        {
          "text": "[الحكاية]",
          "heading": true
        },
        {
          "text": "احك بأيٍّ ما لمنكور ٍ سئل ... عنه بها في الوقف أو حين تصل",
          "heading": false
        },
        {
          "text": "ووقفاً احكِ ما لمنكور ٍ بمن ... والنّون حرّك مطلقاً وأشبعن",
          "heading": false
        },
        {
          "text": "وقل منان ومنين بعد لي ... إلفان بابنين وسكِّن تعدِل",
          "heading": false
        },
        {
          "text": "وقل لمن قال أتت بنتّ منه ... والنّونُ قبل تا المثنّى مسكنه",
          "heading": false
        },
        {
          "text": "والفتح نزرّ وصل التا والألف ... بمن بإثر ذا بنسوة ٍ كل",
          "heading": false
        },
        {
          "text": "وقل منون ومنين مُسكناً ... إن قيل جا قومّ لقوم ٍ فطنا",
          "heading": false
        }
      ]
    },
    {
      "page": 112,
      "printed_page": 63,
      "url": "https://shamela.ws/book/8522/112",
      "paragraphs": [
        {
          "text": "وإن تصل فلفظ من لا يختلف ... ونادرّ منون في نظم ٍ عُرف",
          "heading": false
        },
        {
          "text": "والعلم احكينّه من بعد من ... إن عريت من عاطف ٍ بها اقترن",
          "heading": false
        }
      ]
    },
    {
      "page": 113,
      "printed_page": 63,
      "url": "https://shamela.ws/book/8522/113",
      "paragraphs": [
        {
          "text": "[التأنيث]",
          "heading": true
        },
        {
          "text": "علامة التأنيث تاءّّ أو ألف ... وفي أسام قدّروا التاء كالكتف",
          "heading": false
        },
        {
          "text": "ويُعرف التقدير بالضمير ... ونحوه كالرّدّ في الصغير",
          "heading": false
        },
        {
          "text": "ولا تلي فارقة ً فعولا ... أصلا ً ولا المفعال والمفعيلا",
          "heading": false
        },
        {
          "text": "كذاك مِفعَل ّ وما تليه تا ... الفرق من ذي فشذودّ فيه",
          "heading": false
        },
        {
          "text": "ومن فعيل ٍ كقتيل ٍ إن تبع ... موصوفه غالبا ً التا تمتنع",
          "heading": false
        },
        {
          "text": "وألف التأنيث ذات قصر ... وذات مدٍّ نحو أنثى الغرِّ",
          "heading": false
        },
        {
          "text": "والإشتهار في مباني الأولى ... يبديه وزن أربى والطولى",
          "heading": false
        },
        {
          "text": "ومرطى ووزن فعْلى جمْعا ... أو مصدرا ً أو صفة ً كشبعى",
          "heading": false
        },
        {
          "text": "وكحُبَارى سمّهى سبطري ... ذكرى وحثيثى مع الكفرّى",
          "heading": false
        },
        {
          "text": "كذاك خليطى مع الشُّقَّارى ... واعزُ لغير هذه استندارا",
          "heading": false
        },
        {
          "text": "لمدّها فعلاء أفعلاء ... مثلث العين وفعللاء",
          "heading": false
        },
        {
          "text": "ثمّ فعلا فعللا فاعولا ... وفاعلاء فعليا مفعولا",
          "heading": false
        },
        {
          "text": "ومطلق العين فعالا وكذا ... مطلق فاءٍ فعلاء أخِذا",
          "heading": false
        }
      ]
    },
    {
      "page": 114,
      "printed_page": 64,
      "url": "https://shamela.ws/book/8522/114",
      "paragraphs": [
        {
          "text": "[المقصور والممدود]",
          "heading": true
        },
        {
          "text": "إذا اسمّ استوجب من قبل الطرف ... فتحا ً وكان ذا نظير ٍ كالأسف",
          "heading": false
        },
        {
          "text": "فلنظيره المُعَلِّ الآخر ... ثبوت قصر ٍ بقياس ٍ ظاهر",
          "heading": false
        },
        {
          "text": "كفعل ٍوفُعلٍ في جمع ما ... كفعلةٍ وفُعلةٍ نحو الدّمى",
          "heading": false
        },
        {
          "text": "وما استحق قبل آخر ٍ ألف ... فالمدّ في نظيره حتماً عُرف",
          "heading": false
        },
        {
          "text": "كمصدر ِ الفعل الذي قد بُدِئا ... بهمز ٍ وصل ٍ كارعوى وكارتأى",
          "heading": false
        },
        {
          "text": "والعادم النظير ذا قصر ٍ وذا ... مدٍّ بنقل ٍ كالحجا وكالحذا",
          "heading": false
        },
        {
          "text": "وقصر ذي المدِّ اضطراراً مُجمَع ... عليه والعكس بحلف ٍ يقع",
          "heading": false
        }
      ]
    },
    {
      "page": 115,
      "printed_page": 64,
      "url": "https://shamela.ws/book/8522/115",
      "paragraphs": [
        {
          "text": "كيفيّة تثنية المقصور والممدود وجمعهما تصحيحاً:",
          "heading": false
        },
        {
          "text": "آخرَ مقصور ٍ تثنّى اجعله يا ... إن كان عن ثلاثةٍ مرتقيا",
          "heading": false
        },
        {
          "text": "كذا الذي اليا أصله نحو الفتى ... والجامدُ الذي أميل كمتى",
          "heading": false
        },
        {
          "text": "في غير ذا تقلب واواً الألف ... وأولها ما كان قبل قد ألِف",
          "heading": false
        },
        {
          "text": "وما كصحراء بواو ٍ ثنّيا ... ونحو علباءٍ كساءٍ وحيا",
          "heading": false
        },
        {
          "text": "بواو ٍ او همز ٍ وغير ما ذكر ... صحّح وما شذّ على نقل ٍ قُصِر",
          "heading": false
        },
        {
          "text": "واحذف من المقصور في جمع على ... حدّ المثنّى ما به تكمّلا",
          "heading": false
        }
      ]
    },
    {
      "page": 116,
      "printed_page": 65,
      "url": "https://shamela.ws/book/8522/116",
      "paragraphs": [
        {
          "text": "والفتح أبق مشعراً بما حُذِف ... وإن جمعته بتاء وألف",
          "heading": false
        },
        {
          "text": "فالألف اقلب قلبها في التثنيه ... وتاء ذي التا ألزمنّ تنحيَه",
          "heading": false
        },
        {
          "text": "والسّالم العين الثلاثي اسماً أنِل ... إتباع عين ٍ فاءهُ بما شُكِل",
          "heading": false
        },
        {
          "text": "إن ساكن العين مؤنثاً بدا ... مختتماً بالتاء أو مجرّدا",
          "heading": false
        },
        {
          "text": "وسكّن التالي غير الفتح أو ... خفّفه بالفتح فكلا ً قد رووا",
          "heading": false
        },
        {
          "text": "ومنعوا إتباع نحو ذروه ... وزبيةٍ وشذّ كسر جروه",
          "heading": false
        },
        {
          "text": "ونادرّ أو ذو اضطرار ٍ غير ما ... قدمته أو لأناس ٍ انتمى",
          "heading": false
        }
      ]
    },
    {
      "page": 117,
      "printed_page": 65,
      "url": "https://shamela.ws/book/8522/117",
      "paragraphs": [
        {
          "text": "[جمع التكسير]",
          "heading": true
        },
        {
          "text": "أفعلة ّ أفعل ثمّ فِعله ... تمَّت أفعال ّ جموع قلة",
          "heading": false
        },
        {
          "text": "وبعض ذي بكثرة ٍ وضعاً يفي ... كأرجل ٍ والعكس جاء كالصُفيّ",
          "heading": false
        },
        {
          "text": "لفعل ٍ اسماً صحّ عيناً أفعل ... وللرباعيّ اسماً أيضا يُجعل",
          "heading": false
        },
        {
          "text": "إن كان كالعناق والذراع في ... مدٍّ وتأنيث ٍ وعدِّ الأحرف",
          "heading": false
        },
        {
          "text": "وغير ما أفعل فيه مطّرد ... من الثلاثي اسماً بأفعال ٍ يرد",
          "heading": false
        },
        {
          "text": "وغالباً أغناهم فعلان ... في فعل ٍ كقولهم صردان",
          "heading": false
        },
        {
          "text": "في اسم ٍ مذكّر ٍ رباعيٍّ بمد ... ثالث ٍ افعلة عنهم اطّرد",
          "heading": false
        }
      ]
    },
    {
      "page": 118,
      "printed_page": 66,
      "url": "https://shamela.ws/book/8522/118",
      "paragraphs": [
        {
          "text": "والزمه في فعال ٍ أو فِعال ... مصاحبي تضعيف ٍ أو اعلال ٍ",
          "heading": false
        },
        {
          "text": "فعل ّّ لنحو أحمر ٍ وحمرا ... وفعلة ّ جمعاً بنقل ٍ يُدرى",
          "heading": false
        },
        {
          "text": "وفعل ّ لاسم ٍ رباعيٍّ بمد ... قد زيدّ قبل لام ٍ اعلالا ً فقد",
          "heading": false
        },
        {
          "text": "ما لم يضاعف في الأعمّ ذو الألف ... وفعل ّ جمعاً لفعلة ٍ عُرِف",
          "heading": false
        },
        {
          "text": "ونحو كبرى ولفعلة ٍ فعل ... وقد يجئ جمعه على فعل",
          "heading": false
        },
        {
          "text": "في نحو رام ٍ اطّرادٍ فعله ... وشاع نحو كامل ٍ وكمله",
          "heading": false
        },
        {
          "text": "فعلى لوصف ٍ كقتيل ٍ وزمن ... وهالك ٍ وميّتّ به قمن",
          "heading": false
        },
        {
          "text": "لفعل ٍ اسماً صحَّ لاماً فعله ... والوضع في فعل ٍ وفعل ٍ قلله",
          "heading": false
        },
        {
          "text": "وفُعَّل ّ لفاعل ٍ وفاعله ... وصفين نحو عاذل ٍ وعاذله",
          "heading": false
        },
        {
          "text": "ومثله الفعّال فيما ذكّرا ... وذان في المعلِّ لاماً تدرا",
          "heading": false
        },
        {
          "text": "فعل ّ وفعلة ّ فِعال ّ لهما ... وقلَّ فيما عينه اليا منهما",
          "heading": false
        },
        {
          "text": "وفعل ّ أيضاً له فعال ... ما لم يكن في لامه اعتلال",
          "heading": false
        },
        {
          "text": "أو يك مضعفاً ومثل فعل ... ذو التا وفعل مع فعل ٍ فاقبل",
          "heading": false
        },
        {
          "text": "وفي فعيل ٍ وصف فاعل ٍ ورد ... كذاك في أنثاه أيضا اطّرد",
          "heading": false
        },
        {
          "text": "وشاع في وصف ٍ على فعلانا ... أو انثييه أو على فعلانا",
          "heading": false
        },
        {
          "text": "ومثله فعلانة ّ والزمه في ... نحو طويل ٍ وطويلة ٍ تفي",
          "heading": false
        }
      ]
    },
    {
      "page": 119,
      "printed_page": 67,
      "url": "https://shamela.ws/book/8522/119",
      "paragraphs": [
        {
          "text": "وبفعول ٍ فعِل ّ نحو كبد ... يُخصُّ غالباً كذاك يطّرد",
          "heading": false
        },
        {
          "text": "في فعل ٍ اسماً مطلق الفا وفعل ... له وللفُعال فعلانّ حصل",
          "heading": false
        },
        {
          "text": "وشاع في حوت ٍ وقاع ٍ مع ما ... ضاهاهما وقلَّ في غيرهما",
          "heading": false
        },
        {
          "text": "وفعلا ً اسماً وفعيلا ً وفعل ... غير معلِّ العين فعلانّ شمل",
          "heading": false
        },
        {
          "text": "ولكريم ٍ وبخيل ٍ فعلا ... كذا لما ضاهاهما قد جُعِلا",
          "heading": false
        },
        {
          "text": "وناب عنه أفعلاء في المعلّ ... لاماً ومُضعَف ٍ وغير ذاك قل",
          "heading": false
        },
        {
          "text": "فواعل ّ لفوعل ٍ وفاعل ... وفاعلاء مع نحو كاهل",
          "heading": false
        },
        {
          "text": "وحائض ٍ وصاهل ٍ وفاعله ... وشذّ في الفارس مع ما ماثله",
          "heading": false
        },
        {
          "text": "وبفعائل اجمعن فعاله ... وشبهه ذا تاءٍ أو مزاله",
          "heading": false
        },
        {
          "text": "وبالفعالي والفعالى جُمِعا ... صحراء والعذراء والقيس اتبعا",
          "heading": false
        },
        {
          "text": "واجعل فعاليَّ لغير ذي نسب ... جُدِّد كالكرسيّ تتبع العرب",
          "heading": false
        },
        {
          "text": "وبفعالل وشبهه انطقا ... في جمع ما فوق الثلاثة ارتقى",
          "heading": false
        },
        {
          "text": "من غير ما مضى ومن خماسي ... جُرِّد الآخر انف ِ بالقياس",
          "heading": false
        },
        {
          "text": "والرّابعُ الشبيه بالمزيد قد ... يحذف دون ما به تمّ العدد",
          "heading": false
        },
        {
          "text": "وزائد العادي الرباعي احذفه ... ما لم يك ليناً إثره اللذ ختما",
          "heading": false
        },
        {
          "text": "والسّين والتا من كمستدع ٍ أزل ... إذ ببنا الجمع ِ بقاهما مُخِلّ",
          "heading": false
        }
      ]
    },
    {
      "page": 120,
      "printed_page": 68,
      "url": "https://shamela.ws/book/8522/120",
      "paragraphs": [
        {
          "text": "والميمُ أولى من سواهُ بالبقا ... والهمز والياء مثله إن سبقا",
          "heading": false
        },
        {
          "text": "والياء لا الواو احذف ان جمعت ما ... كحَيْز بون ٍ فهو حكمّ حُتِما",
          "heading": false
        },
        {
          "text": "وخيّروا في زائدي سرندى ... وكلِّ ما ضاهاه كالعلندى",
          "heading": false
        }
      ]
    },
    {
      "page": 121,
      "printed_page": 68,
      "url": "https://shamela.ws/book/8522/121",
      "paragraphs": [
        {
          "text": "[التصغير]",
          "heading": true
        },
        {
          "text": "فُعيلا ً اجعل الثلاثيّ إذا ... صغّرته نحوُ قُذيٍّ في قذا",
          "heading": false
        },
        {
          "text": "فُعيعِلّ مع فُعيعيل ٍ لما ... فاق كجعل درهم ٍ دريهما",
          "heading": false
        },
        {
          "text": "وما به لمنتهى الجمع وُصِل ... به إلى أمثلة التصغير صِل",
          "heading": false
        },
        {
          "text": "وجائزّ تعويضُ يا قبل الطرف ... إن كان بعضُ الاسم فيهما انحذف",
          "heading": false
        },
        {
          "text": "وحائدّ عن القياس كلّ ما ... خالف في البابين حكماً رُسِما",
          "heading": false
        },
        {
          "text": "لتلو يا التصغير من قبل عَلم ... تأنيث ٍ أو مدّتِه الفتح انحتم",
          "heading": false
        },
        {
          "text": "كذاك ما مدّة أفعال ٍسبق ... أو مدَّ سكران وما به التحق",
          "heading": false
        },
        {
          "text": "وألِفُ التأنيث حيث مُدّا ... وتاؤه منفصلين عدّا",
          "heading": false
        },
        {
          "text": "كذا المزيد آخراً للنسب ... وعجزُ المضاف والمركّب",
          "heading": false
        },
        {
          "text": "وهكذا زيادتنا فعلانا ... من بعد أربع ٍ كزعفرانا",
          "heading": false
        },
        {
          "text": "وقدّر انفصال ما دلّ على ... تثنيةٍ أو جمع تصحيح ٍ جلا",
          "heading": false
        }
      ]
    },
    {
      "page": 122,
      "printed_page": 69,
      "url": "https://shamela.ws/book/8522/122",
      "paragraphs": [
        {
          "text": "وألِف التأنيث ذو القصر متى ... زاد على أربعة لن يُثبتا",
          "heading": false
        },
        {
          "text": "وعند تصغير حُبارى خيِّر ... بين الحبُيرى فاد والحُبيِّر",
          "heading": false
        },
        {
          "text": "واردُدْ لأصل ٍ ثانياً ليناً قلِب ... فقيمة ً صَيِّر قويمة ً تصب",
          "heading": false
        },
        {
          "text": "وشذّ في عيدٍ عُييدّ وحُتم ... للجمع من ذا ما لتصغير ٍ عُلِم",
          "heading": false
        },
        {
          "text": "والألف الثان المزيدُ يُجعلُ ... واواً كذا ما الأصل فيه يُجهل",
          "heading": false
        },
        {
          "text": "وكمِّل المنقوص في التصغير ما ... لم يحوِ غير التاء ثالثاً كما",
          "heading": false
        },
        {
          "text": "ومَن بترخيم ٍ يُصغّر اكتفى ... بالأصل كالعُطيف يعني المِعطفا",
          "heading": false
        },
        {
          "text": "اختم بتا التأنيث ما صغّرت ... مِن مؤنّثٍ غار ٍ ثلاثيٍّ كسِن",
          "heading": false
        },
        {
          "text": "ما لم يكن بالتا يُرى ذا لبس ... كشجر ٍ وبقر ٍ وخمْس",
          "heading": false
        },
        {
          "text": "وشذّ ترك دون لبس ٍ وندَر ... لحاق تا فيما ثلاثيًّا كثر",
          "heading": false
        },
        {
          "text": "وصغَّروا شذوذاً الذي التي ... وذا مع الفروع منها تا وتي",
          "heading": false
        }
      ]
    },
    {
      "page": 123,
      "printed_page": 69,
      "url": "https://shamela.ws/book/8522/123",
      "paragraphs": [
        {
          "text": "النّسَب:",
          "heading": false
        },
        {
          "text": "ياءً كيا الكرسيِّ زادوا للنسب ... وكلُّ ما تليه كسرُهُ وَجَب",
          "heading": false
        },
        {
          "text": "ومثله ممّا حواهُ احذف وتا ... تأنيث ٍأو مدَّته لا تثبتا",
          "heading": false
        },
        {
          "text": "وإن تكن تربَعُ ذا ثان ٍ سكن ... فقلبُها واواً وحذفها حسن",
          "heading": false
        }
      ]
    },
    {
      "page": 124,
      "printed_page": 70,
      "url": "https://shamela.ws/book/8522/124",
      "paragraphs": [
        {
          "text": "لشبهها الملحق والأصليِّ ما ... لها وللأصليِّ قلبّ يُعتمى",
          "heading": false
        },
        {
          "text": "والألِف الجائز أربعا أزل ... كذاك يا المنقوص خامساً عُزل",
          "heading": false
        },
        {
          "text": "والحذف في اليا رابعاً أحقُّ من ... قلبٍ وحتمّ قلبُ ثالثٍ يَعِنّ",
          "heading": false
        },
        {
          "text": "وأول ذا القلب انفتاحاً وفعِل ... وفعلّ عينهما افتح وفِعِل",
          "heading": false
        },
        {
          "text": "وقيل في المرميِّ مرمويُّ ... واختير في استعمالهم مرميُّ",
          "heading": false
        },
        {
          "text": "ونحو حيٍّ فتحُ ثانِيه يجب ... واردده واواً إن يكن عنه قلِب",
          "heading": false
        },
        {
          "text": "وعلم التثنية احذِف للنسب ... ومثلُ ذا في جمع تصحيح ِ وجب",
          "heading": false
        },
        {
          "text": "وثالثّ من نحو طيِّب ٍ حُذِف ... وشذَّ طائيُّ مقولا ً بالألف",
          "heading": false
        },
        {
          "text": "وفعليُّ في فعيلة التزم ... وفعليّّّ في فعيلة ٍ حُتِم",
          "heading": false
        },
        {
          "text": "وألحقوا مُعَلَّ لام ٍ عريا ... من المثالين بما التا أوليا",
          "heading": false
        },
        {
          "text": "وتمَّموا ما كان كالطويله ... وهكذا ما كان كالجليله",
          "heading": false
        },
        {
          "text": "وهمز ذي مدٍّ ينال في النسب ... ما كان في تثنية ٍ له انتسب",
          "heading": false
        },
        {
          "text": "وانسُب لصدر جملة ٍ وصدر ... ما رُكِّب مزجاً ولثان ٍ تمَّما",
          "heading": false
        },
        {
          "text": "إضافة ً مبدوءة ً بابن ٍ أو اب ... أو ماله التعريف بالثاني وَجَب",
          "heading": false
        },
        {
          "text": "فيما سوى هذا انسُبن للأوّل ... ما لم يُخف لبسّ كعبدِ الأشهل",
          "heading": false
        },
        {
          "text": "واجبر بردِّ اللام ما منه حُذِف ... جوازاً ان لم يكُ ردُّ ألف",
          "heading": false
        }
      ]
    },
    {
      "page": 125,
      "printed_page": 71,
      "url": "https://shamela.ws/book/8522/125",
      "paragraphs": [
        {
          "text": "في جمعي التصحيح أو في التثنيه ... وحقُّ مجبور ٍبهاذي بتوفيه",
          "heading": false
        },
        {
          "text": "وبأخ ٍ أختاًً وبابن ٍ بنتاً ... ألحِق ويُونسُ أبى حذف التا",
          "heading": false
        },
        {
          "text": "وضاعفِ الثاني من ثنائي ... ثانيه ذولين ٍ كلا ولائي",
          "heading": false
        },
        {
          "text": "وإن يكن كشِيَةٍ ما الفا عدم ... فجبرُهُ وفتحُ عينيه التزم",
          "heading": false
        },
        {
          "text": "والواحد اذكر ناسباً للجمع ... إن لم يشابه واحداً بالوضع",
          "heading": false
        },
        {
          "text": "ومع فاعل ٍ وفعّال ٍ فعِل ... في نسبٍ أغنى عن اليا فقبِل",
          "heading": false
        },
        {
          "text": "وغير ما أسلفته مقرّراً ... على الذي يُنقلُ منه اقتصرا",
          "heading": false
        }
      ]
    },
    {
      "page": 126,
      "printed_page": 71,
      "url": "https://shamela.ws/book/8522/126",
      "paragraphs": [
        {
          "text": "[الوقف]",
          "heading": true
        },
        {
          "text": "تنويناً اثر فتح ٍ اجعل ألفا ... وقفاً وتلو غير فتح ٍ احذفا",
          "heading": false
        },
        {
          "text": "واحذف لوقف ٍ في سوى اضطرار ... صلة غير الفتح في الإضمار",
          "heading": false
        },
        {
          "text": "وأشبهت إذاً منوناً نُصِب ... فألِفاً في الوقف نونها قلِب",
          "heading": false
        },
        {
          "text": "وحذفُ يا المنقوص ذي التنوين ... ما لم يُنصَب اولى من ثبون فاعلما",
          "heading": false
        },
        {
          "text": "وغيرُ ذي التنوين بالعكس وفي ... نحو مر ٍ لزوم ردِّ اليا اقتفي",
          "heading": false
        },
        {
          "text": "وغيرها التأنيث من مُحرُّك ... سكِّنه أو قِف رائم التحرك",
          "heading": false
        },
        {
          "text": "أو أشمِم الضّمّة أو قف مُضعِفا ... ما ليس همزاً أو عليلا ً إن قفا",
          "heading": false
        },
        {
          "text": "محرِّكاً وحركات ٍ انقلا ... لساكن تحريكُهُ لن يُحظلا",
          "heading": false
        }
      ]
    },
    {
      "page": 127,
      "printed_page": 72,
      "url": "https://shamela.ws/book/8522/127",
      "paragraphs": [
        {
          "text": "ونقلُ فتح ٍ من سوى المهموزلا ... يراه بصريّّّ وكوف ٍ نقلا",
          "heading": false
        },
        {
          "text": "والنقل إن يُعدم نظيرّ ممتنع ... وذاك في المهموز ليس يمتنع",
          "heading": false
        },
        {
          "text": "في الوقف تا تأنيث الاسم ها جُعِل ... إن لم يكن بساكن ٍ صحَّ وُصِل",
          "heading": false
        },
        {
          "text": "وقلَّ ذا في جمع تصحيح ٍ وما ... ضاهى وغيرُ ذين بالعكس انتمى",
          "heading": false
        },
        {
          "text": "وقف بها السكت على الفعل المُعل ... بحذف آخر ٍ كأعط من سأل",
          "heading": false
        },
        {
          "text": "وليس حتماً في سوى ماكَع ِأو ... كيَع ِ مجزوماً فراع ِ ما رُعَوا",
          "heading": false
        },
        {
          "text": "وما في الاستفهام إن جُرَّت حُذِف ... ألِفها وأولها الها إن تقف",
          "heading": false
        },
        {
          "text": "وليس حتماً في سوى ما انخفضا ... باسم ٍكقولك اقتضاء مَ اقتضى",
          "heading": false
        },
        {
          "text": "ووصل ذي الهاء أجز بكلِّ ما ... حرِّك تحريك بناءٍ لزما",
          "heading": false
        },
        {
          "text": "ووصلها بغير تحريك بنا ... أديم شذَّ في المُدام استحسنا",
          "heading": false
        },
        {
          "text": "لربّما أعطى لفظُ الوصل ما ... للوقوف نثراً وفشا منتظماً",
          "heading": false
        }
      ]
    },
    {
      "page": 128,
      "printed_page": 72,
      "url": "https://shamela.ws/book/8522/128",
      "paragraphs": [
        {
          "text": "[الإمالة]",
          "heading": true
        },
        {
          "text": "الألِفُ المبْدَلَ مِن يا في طرف ... أمِل كذا الواقعُ منه اليا خلف",
          "heading": false
        },
        {
          "text": "دون مزيدٍ أو شذوذٍ ولِما ... تليه ها التأنيث ما الها عَدِما",
          "heading": false
        },
        {
          "text": "وهكذا بَدَلُ عين الفعل إن ... يؤل الى فلت كماضي خف ودِن",
          "heading": false
        }
      ]
    },
    {
      "page": 129,
      "printed_page": 73,
      "url": "https://shamela.ws/book/8522/129",
      "paragraphs": [
        {
          "text": "كذاك تالي الياء والفصل اغتفر ... بحرف ٍ أو مع هاكجيبها أدِر",
          "heading": false
        },
        {
          "text": "كذاك ما يليه كسرّ أو يلي ... تالي كسرٍ أو سكون ٍ قد ولي",
          "heading": false
        },
        {
          "text": "كسراً وفصلُ الها كلا فصل ٍ يُعدّ ... فدرهماك من يمله لم يصدّ",
          "heading": false
        },
        {
          "text": "وحرف الاستعلا يكُفُّ مُظهرا ... من كسر ٍ أو يا وكذا تُكَفُّ زا",
          "heading": false
        },
        {
          "text": "إن كان ما يكفُّ بعد متصل ... أو بعد حرف ٍ أو بحرفين فصِل",
          "heading": false
        },
        {
          "text": "كذا إذا قدِّم ما لم ينكسر ... أو يسكُن إثرَ الكسر كالمطواع مِر",
          "heading": false
        },
        {
          "text": "وكُفَّ مُستعل ٍ ورا ينكفُّ ... بكسر را كغارماً لا أجفو",
          "heading": false
        },
        {
          "text": "ولا تُمِلْ لسببٍ ما لم يتصل ... والكفُّ قد يوجبه ما ينفصل",
          "heading": false
        },
        {
          "text": "وقد أمالوا لتناسبٍ بلا ... داع ٍ سواها كعمادا وتلا",
          "heading": false
        },
        {
          "text": "ولا تُمِل ما لم ينل تمكّنا ... دون سماع ٍ غيرها وغيرنا",
          "heading": false
        },
        {
          "text": "والفتح قبل كسر راءٍ في طرف ... امِلْ كللأيسر مل تكف الكُلف",
          "heading": false
        },
        {
          "text": "كذا الذي تليه ها التأنيث في ... وقف إذا ما كان غير ألِف",
          "heading": false
        }
      ]
    },
    {
      "page": 130,
      "printed_page": 73,
      "url": "https://shamela.ws/book/8522/130",
      "paragraphs": [
        {
          "text": "[التصريف]",
          "heading": true
        },
        {
          "text": "حرفّ وشبهُهُ من الصرف بري ... وما سواهما بتصريف حري",
          "heading": false
        },
        {
          "text": "وليس أدنى من ثلاثي ٍ يُرى ... قابلَ تصريف ٍ سوى ما غيرا",
          "heading": false
        }
      ]
    },
    {
      "page": 131,
      "printed_page": 74,
      "url": "https://shamela.ws/book/8522/131",
      "paragraphs": [
        {
          "text": "ومنتهى اسم ٍ خمسّ أن تجرَّدا ... وإن يُزد فيه فما سبعا عدا",
          "heading": false
        },
        {
          "text": "وغير اخر الثلاثي افتح وضُمّ ... واكسِر وزد تسكين ثانيه تعُمّ",
          "heading": false
        },
        {
          "text": "وفعلّ أهمُلَ والعكسُ يقلّ ... لقصدهم تخصيص فعل ٍ بفعل",
          "heading": false
        },
        {
          "text": "وافتح وضُم واكسر الثاني من ... فعل ِ ثلاثيٍّ وزد نحو ضْمِن",
          "heading": false
        },
        {
          "text": "ومنتهاهُ أربعّ إن جُرّدا ... وإن يُزد فيه فما ستاً عُدا",
          "heading": false
        },
        {
          "text": "لاسم ٍ مُجرَّدٍ رُباع ٍ فعلل ... وفعللّ وفِعللّ وفُعلل",
          "heading": false
        },
        {
          "text": "ومع فعلٍّ فُعللّ وإن ... علا فمع فعلّل ٍ حوى فعللا",
          "heading": false
        },
        {
          "text": "كذا فُعّللّ وفِعللّ وما ... غاير للزّبد أو النقص انتمى",
          "heading": false
        },
        {
          "text": "والحرفُ إن يلزم فأصلّ والذي ... لا يلزمُ الزائدُ مثل تا احتُذِى",
          "heading": false
        },
        {
          "text": "بضمن فعل قابل الأصول في ... وزن ٍ وزائدّ بلفظه اكتفي",
          "heading": false
        },
        {
          "text": "وضاعف اللام إذا أصلّ بقى ... كراء جعفر ٍوقاف فستق",
          "heading": false
        },
        {
          "text": "وإن يك الزائدُ ضِعف أصل ... فاجعل في الوزن ما للأصل",
          "heading": false
        },
        {
          "text": "واحكم بتأصيل حروف سمسم ... ونحوه والخلف في كلملم",
          "heading": false
        },
        {
          "text": "فبألِفّ أكثر من أصلين ... صاحَبَ زائدّ بغير مين",
          "heading": false
        },
        {
          "text": "واليا كذا والواو إن لم يقعا ... كما هما في يؤيؤ ٍ وعوعا",
          "heading": false
        }
      ]
    },
    {
      "page": 132,
      "printed_page": 75,
      "url": "https://shamela.ws/book/8522/132",
      "paragraphs": [
        {
          "text": "وهكذا همزّ وميمِّ سبقا ... ثلاثة ً تأصيلها تحقّقا",
          "heading": false
        },
        {
          "text": "كذاك همز ِ اخرّ بعد ألِف ... أكثر من حرفين لفظها ردِف",
          "heading": false
        },
        {
          "text": "والنون في الآخِر كالهمز وفي ... نحو غَضَنفر ٍ أصالة ً كُفي",
          "heading": false
        },
        {
          "text": "والتاء في التأنيث والمضارعه ... ونحو الاستفعال والمطاوعه",
          "heading": false
        },
        {
          "text": "والهاء وقفاً كلمه ولم نره ... واللام في الإشارة المُشتهره",
          "heading": false
        },
        {
          "text": "وامنع زيادة ً بلا قيدٍ ثبت ... إن لم تبيّن حجّةّ كحِظلت",
          "heading": false
        }
      ]
    },
    {
      "page": 133,
      "printed_page": 75,
      "url": "https://shamela.ws/book/8522/133",
      "paragraphs": [
        {
          "text": "فصلّ في زيادة همزة الوصل:",
          "heading": false
        },
        {
          "text": "للوصل همزّ سابقّ لا يثبُتُ ... إلا إذا ابتُدِىَ به كاستثبتوا",
          "heading": false
        },
        {
          "text": "وهو لفعل ٍ ماض ٍ احتوى على ... أكثر من أربعة ٍ نحو انجلى",
          "heading": false
        },
        {
          "text": "والأمر والمصدر ِ منه وكذا ... أمرُ الثلاثي كاخشَ وامض ِ وانفذا",
          "heading": false
        },
        {
          "text": "وفي اسم ٍ استٍ ابن ٍ ابنم ٍ سُمِع ... واثنين وامرئ وتأنيثٍ تبع",
          "heading": false
        },
        {
          "text": "وايْمُنُ همزُ أل كذا ويُبدلُ ... مدّاً في الاستفهام أو يُسهَّلُ",
          "heading": false
        }
      ]
    },
    {
      "page": 134,
      "printed_page": 75,
      "url": "https://shamela.ws/book/8522/134",
      "paragraphs": [
        {
          "text": "[الإبدال]",
          "heading": true
        },
        {
          "text": "أحرفُُ الإبدال هدأت موطيا ... فأبدل الهمزة من واو ٍ ويا",
          "heading": false
        },
        {
          "text": "آخراً اثر ألِفٍ زيدَ وفى ... فاعل ما أعلَّ عيناً ذا اقتفي",
          "heading": false
        }
      ]
    },
    {
      "page": 135,
      "printed_page": 76,
      "url": "https://shamela.ws/book/8522/135",
      "paragraphs": [
        {
          "text": "والمدُّ زيدَ ثالثاً في الواحد ... همزاً يُرى في مثل كالقلائد",
          "heading": false
        },
        {
          "text": "كذاك ثاني ليّنين اكتنفا ... مدَّ مفاعل كجمع ٍ نيّفا",
          "heading": false
        },
        {
          "text": "وافتح ورُدَّ الهمز يا فيما أعِلّ ... لاماً وفي هراوةٍ جُعِل",
          "heading": false
        },
        {
          "text": "واواً وهمزاً أوّل الواوين رُدَّ ... في بدء غير شبه ووُفيَ الأشدُّ",
          "heading": false
        },
        {
          "text": "ومدّاً ابدِل ثانيَ الهمزين من ... كلمةٍ ان يسكُنْ كآثر وائتمن",
          "heading": false
        },
        {
          "text": "إن يُفتح اثر ضمٍّ او فتح ٍ قُلِب ... واواً وياء إثر كسر ٍ ينقلب",
          "heading": false
        },
        {
          "text": "ذو الكسر مطلقا كذا وما يُضمُّ ... واواً أصر ما لم يكن لفظاً أتمُّ",
          "heading": false
        },
        {
          "text": "فذاك ياءً مُطلقاً جا وأؤمُّ ... ونحوهُ وجهين في ثانيه أم",
          "heading": false
        },
        {
          "text": "وياءً اقلب ألِفاً كسراًً تلا ... أو ياءَ تصغير ٍ بواو ٍ ذا افعلا",
          "heading": false
        },
        {
          "text": "في آخر ٍ أو قبل تا التأنيث أو ... زيادتي فعلان ذا أيضاً رأوا",
          "heading": false
        },
        {
          "text": "في مصدر المعتلِّ عيناً والفعل ... منه ُ صحيحّ غالباً نحوُ الحِوَل",
          "heading": false
        },
        {
          "text": "وجمعُ ذي عين ٍ أعِلَّ أو سكن ... فاحكم بذا الإعلال فيه حيث عنّ",
          "heading": false
        },
        {
          "text": "وصحَّحوا فعلة ً وفي فِعَل ... وجهان والإعلالُ أولى كالخِيَل",
          "heading": false
        },
        {
          "text": "والواو لاماً بعد فتح ٍ يا انقلب ... لمعطيان يرضيان ووَجَب",
          "heading": false
        },
        {
          "text": "إبدالُ واو ٍ بعد ضمَّ من ألِف ... ويا كموقن ٍ بذا لها اعتُرف",
          "heading": false
        }
      ]
    },
    {
      "page": 136,
      "printed_page": 77,
      "url": "https://shamela.ws/book/8522/136",
      "paragraphs": [
        {
          "text": "ويُكسرُُ المضمومُ في جمع ٍ كما ... يُقالُ هيم ّ عند جمع أهيما",
          "heading": false
        },
        {
          "text": "وواواً اثرَ الضّمَّ رُدَّ اليا متى ... ألفي لام فعل ٍ او من قبل تا",
          "heading": false
        },
        {
          "text": "كتاء بان ٍ من رمى كمقدره ... كذا إذا كسَبُعان صيَّرَه",
          "heading": false
        },
        {
          "text": "وإن تكن عيناً لِفعلَى وصفاً ... فذاك بالوجهين عنهم يُلفى",
          "heading": false
        }
      ]
    },
    {
      "page": 137,
      "printed_page": 77,
      "url": "https://shamela.ws/book/8522/137",
      "paragraphs": [
        {
          "text": "[فصل]",
          "heading": true
        },
        {
          "text": "من لام ِ فعَلى اسماً أتى الواو بدل ... ياءٍ كتقوى غالباً جا ذا البدل",
          "heading": false
        },
        {
          "text": "بالعكس جاء لام فُعلى وصفاً ... وكونُ قصوى نادراً لا يخفى",
          "heading": false
        }
      ]
    },
    {
      "page": 138,
      "printed_page": 77,
      "url": "https://shamela.ws/book/8522/138",
      "paragraphs": [
        {
          "text": "[فصل]",
          "heading": true
        },
        {
          "text": "إن يَسْكن السابق من واو ٍ ويا ... واتصلا ومن عروض ٍ عزيا",
          "heading": false
        },
        {
          "text": "فياءَ الواو اقلِبن مُدغما ... وشذَّ مُعطى غير ما قد رُسما",
          "heading": false
        },
        {
          "text": "من واو ٍ أو ياءٍ بتحريك أصِل ... ألِفاً أبدِل بعد فتح ٍ مُتّصل",
          "heading": false
        },
        {
          "text": "إن حُرِّك التالي وإن سُكِّنَ كفّ ... إعلال غير ِ اللام وهي لا يُكفّ",
          "heading": false
        },
        {
          "text": "إعلالها بساكن ٍ غير ألِف ... أو ياء التشديدُ فيها قد ألِف",
          "heading": false
        },
        {
          "text": "وصحّ عينُ فعَل ٍ وفعِلا ... ذا أفعَل ِ كأغيَدٍ وأحولا",
          "heading": false
        }
      ]
    },
    {
      "page": 139,
      "printed_page": 78,
      "url": "https://shamela.ws/book/8522/139",
      "paragraphs": [
        {
          "text": "وإن يبِنْ تفاعلّ من افتعل ... والعينُ واوّ سَلِمَت ولم تُعلّ",
          "heading": false
        },
        {
          "text": "وإن لحرفين ذا الإعلالُ استُحِق ... صُحِّحَ أوّلّ وعكسّ قد يحِق",
          "heading": false
        },
        {
          "text": "وعينُ ما اخرهُ قد زيدَ ما ... يخصُّ الاسمَ واجبّ أن يسلما",
          "heading": false
        },
        {
          "text": "وقبل يا اقلب ميماً النونَ إذا ... كان مسكّناً كمن بتّ انبذا",
          "heading": false
        }
      ]
    },
    {
      "page": 140,
      "printed_page": 78,
      "url": "https://shamela.ws/book/8522/140",
      "paragraphs": [
        {
          "text": "[فصل]",
          "heading": true
        },
        {
          "text": "لساكن ٍ صحَّ انقل ِ التحريك من ... ذي لين ٍ آتٍ عين فعل كابِن",
          "heading": false
        },
        {
          "text": "ما لم يكن فعلَ تعجُّبٍ ولا ... كابْيَضَّ أو أهوى بلام ٍ عُلِّلا",
          "heading": false
        },
        {
          "text": "ومثلُ فعل ٍ في ذا الاعلال اسمُ ... ضاهي مضارعاً وفيه وسمُ",
          "heading": false
        },
        {
          "text": "ومِفعَلّ صحِّح كالمفعال ... وألِف الإفعال واستفعال",
          "heading": false
        },
        {
          "text": "أزل لذا الإعلال والتا الزم عِوَض ... وحذفها بالنّقل رُبَّما عرَض",
          "heading": false
        },
        {
          "text": "وما لإفعال ٍ من الحذف ومن ... نقل ٍ فمفعولّ به أيضا قمَن",
          "heading": false
        },
        {
          "text": "نحوُ مبيع ٍ ومصون ٍ وندر ... تصحيح ذي الواو وفي ذي اليا اشتهر",
          "heading": false
        },
        {
          "text": "وصحِّح المفعول من نحو عدا ... وأعلل ان لم تتحرَّ الأجودا",
          "heading": false
        },
        {
          "text": "كذاك ذا وجهين جا الفعُولُ مِن ... ذي الواو لام جمع ٍ او فردٍ يعنّ",
          "heading": false
        },
        {
          "text": "وشاع نحوُ نيَّم ٍ في نُوِّم ... ونحو نُيَّام ٍ شذوذهُ نُمي",
          "heading": false
        }
      ]
    },
    {
      "page": 141,
      "printed_page": 79,
      "url": "https://shamela.ws/book/8522/141",
      "paragraphs": [
        {
          "text": "[فصل]",
          "heading": true
        },
        {
          "text": "ذو اللين فاتا في افتعال ٍ أبدلا",
          "heading": false
        },
        {
          "text": "... وشذّ في ذي الهمز نحو ائتكلا",
          "heading": false
        },
        {
          "text": "طاتا افتعال ٍ رُدَّ إثرَ مُطبق",
          "heading": false
        },
        {
          "text": "... في ادَّانَ وازدد وادَّكِر دالا ً بقي",
          "heading": false
        }
      ]
    },
    {
      "page": 142,
      "printed_page": 79,
      "url": "https://shamela.ws/book/8522/142",
      "paragraphs": [
        {
          "text": "[فصل]",
          "heading": true
        },
        {
          "text": "فا أمر ٍ او مضارع ٍ من كوعَد ... احذِف وفي كعدةٍ ذاك اطَّرد",
          "heading": false
        },
        {
          "text": "وحذفُ همز أفعَلََ استمرَّ في ... مضارع ٍ وبنيتيْ مُتَّصف",
          "heading": false
        },
        {
          "text": "ظِلت وظَلت في ظَلِلتُ استعمِلا ... وقِرنَ في اقرِرنَ وقَََرنَ نُقِلا",
          "heading": false
        }
      ]
    },
    {
      "page": 143,
      "printed_page": 79,
      "url": "https://shamela.ws/book/8522/143",
      "paragraphs": [
        {
          "text": "[الإدغام]",
          "heading": true
        },
        {
          "text": "أول مِثلينِِ مُحركَين في ... كِلمَةٍ ادغِم لا كمِثل صُففِ",
          "heading": false
        },
        {
          "text": "وذُلُلٍ وكِلَلٍ ولَبَبَ ... ولا كَجُسَّس ٍ ولا كاخصص ابي",
          "heading": false
        },
        {
          "text": "ولا كهيللٍٍ وشذَّ في ألل ... ونحوهِ فكّ بنقل ٍ فَقبِِل",
          "heading": false
        },
        {
          "text": "وحيي افكك وادّغم دون حذر ... كذاك نحوُ تتجلى واستتر",
          "heading": false
        },
        {
          "text": "وما بتاءين ابتُدِي قد يُقتصر ... فيه على تاكبَيَّن العِبَر",
          "heading": false
        },
        {
          "text": "وفكَّ حيثُ مُدغمّ فيه سَكن ... لكونه بمُضمَر الرّفع اقترن",
          "heading": false
        }
      ]
    },
    {
      "page": 144,
      "printed_page": 80,
      "url": "https://shamela.ws/book/8522/144",
      "paragraphs": [
        {
          "text": "نحوُ حللت ما حللته وفي ... جزم ٍ وشبه الجزم تخييرّ قفي",
          "heading": false
        },
        {
          "text": "وفكَّ أفعَل في التعجُّب التزم ... والتزم الإدغامُ أيضاً في هلُم",
          "heading": false
        }
      ]
    },
    {
      "page": 145,
      "printed_page": 80,
      "url": "https://shamela.ws/book/8522/145",
      "paragraphs": [
        {
          "text": "[الخاتمه]",
          "heading": true
        },
        {
          "text": "وما بجمعهِ عُنِيتُ قد كمل ... نظماً على جُلَّ المهمّات اشتمل",
          "heading": false
        },
        {
          "text": "أحصى من الكافية الخلاصة ... كما اقتضى غنىً بلا خصاصه",
          "heading": false
        },
        {
          "text": "فأحمد الله مصلياً على ... محمَّدٍ خير نبيٍّ أُرسلا",
          "heading": false
        },
        {
          "text": "وآله الغرَّ الكرام البررة ... وصحبه المنتخبين الخيرة",
          "heading": false
        }
      ]
    }
  ]
}

